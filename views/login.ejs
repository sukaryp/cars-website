<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تسجيل الدخول | AL-CAPTIN SYSTEM</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700;900&display=swap');
        body {
            background: #0f172a;
            font-family: 'Tajawal', sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 28px;
            width: 100%;
            max-width: 400px;
        }
        .glass-input {
            background: rgba(255, 255, 255, 0.05) !important;
            border: 1px solid rgba(255, 255, 255, 0.1) !important;
            color: white !important;
            transition: 0.3s;
        }
        .glass-input:focus {
            border-color: #3b82f6 !important;
            box-shadow: 0 0 15px rgba(59, 130, 246, 0.3);
        }
        .btn-grad {
            background: linear-gradient(135deg, #1d4ed8, #3b82f6);
            transition: 0.4s;
        }
        .btn-grad:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(59, 130, 246, 0.4);
        }
    </style>
</head>
<body>

    <div class="glass-card p-10 shadow-2xl">
        <div class="text-center mb-8">
            <h1 class="text-3xl font-black italic text-white tracking-tighter">
                <span class="text-blue-500">AL-CAPTIN</span> LOGIN
            </h1>
            <p class="text-gray-400 text-xs mt-2 font-bold">يرجى تسجيل الدخول للوصول للفرع الخاص بك</p>
        </div>

        <form onsubmit="handleLogin(event)" class="space-y-6">
            <div class="space-y-2">
                <label class="text-xs text-gray-400 mr-2 font-bold">اسم المستخدم (الموظف)</label>
                <div class="relative">
                    <i class="fas fa-user absolute right-4 top-4 text-gray-500"></i>
                    <input type="text" id="username" class="glass-input w-full p-4 pr-12 rounded-2xl outline-none" placeholder="Username" required>
                </div>
            </div>

            <div class="space-y-2">
                <label class="text-xs text-gray-400 mr-2 font-bold">كلمة المرور</label>
                <div class="relative">
                    <i class="fas fa-lock absolute right-4 top-4 text-gray-500"></i>
                    <input type="password" id="password" class="glass-input w-full p-4 pr-12 rounded-2xl outline-none" placeholder="••••••••" required>
                </div>
            </div>

            <button type="submit" class="btn-grad w-full p-5 rounded-2xl text-white font-black text-lg shadow-xl">
                دخول النظام <i class="fas fa-sign-in-alt ml-2"></i>
            </button>
        </form>

        <p class="text-center text-[10px] text-gray-600 mt-8 font-bold uppercase tracking-widest">Premium Management System v2.0</p>
    </div>

    <script>
        async function handleLogin(e) {
            e.preventDefault();
            const username = document.getElementById('username').value;
            const password = document.getElementById('password').value;

            // سيتم إرسال الطلب للسيرفر للتحقق
            const res = await fetch('/auth/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username, password })
            });

            const data = await res.json();

            if (res.ok) {
                Swal.fire({
                    icon: 'success',
                    title: 'أهلاً بك يا ' + data.name,
                    text: 'جاري تحويلك إلى لوحة تحكم ' + data.branchName,
                    timer: 1500,
                    showConfirmButton: false,
                    willClose: () => {
                        window.location.href = '/dashboard';
                    }
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'خطأ في الدخول',
                    text: 'اسم المستخدم أو كلمة المرور غير صحيحة',
                    confirmButtonText: 'حاول مرة أخرى',
                    confirmButtonColor: '#ef4444'
                });
            }
        }
    </script>
</body>
</html>