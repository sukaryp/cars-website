<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
  <meta charset="UTF-8">
  <title>جرد السيارات والتحصيل | السلسلة العالمية</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body {
      background: linear-gradient(rgba(11, 11, 26, 0.9), rgba(11, 11, 26, 0.9)),
        url('https://images.unsplash.com/photo-1503376780353-7e6692767b70?q=80&w=2070&auto=format&fit=crop');
      background-size: cover; background-position: center; background-attachment: fixed;
      color: #fdfdfd; font-family: 'Segoe UI', sans-serif; min-height: 100vh;
    }

    .glass-card {
      background: rgba(255, 255, 255, 0.07); backdrop-filter: blur(15px);
      -webkit-backdrop-filter: blur(15px); border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 20px;
    }

    .form-control {
      background: rgba(255, 255, 255, 0.9) !important; color: #000 !important;
      border: 1px solid #0dcaf0; font-weight: 600;
    }

    .table { color: #fff !important; border-color: rgba(255, 255, 255, 0.1); }
    .table thead { background: rgba(13, 202, 240, 0.15); color: #0dcaf0; }
    .text-info-custom { color: #0dcaf0 !important; }
    .text-success-custom { color: #2ecc71 !important; }
    .text-danger-custom { color: #e74c3c !important; }

    .spec-item {
      font-size: 0.8rem; background: rgba(255, 255, 255, 0.05);
      padding: 4px 10px; border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.1);
      margin: 2px; display: inline-block;
    }

    .progress {
      background: rgba(255, 255, 255, 0.1) !important; border-radius: 10px;
      height: 10px; margin-bottom: 5px; overflow: hidden;
    }

    .progress-bar-neon {
      background-color: #2ecc71 !important; box-shadow: 0 0 12px #2ecc71;
      width: 0%; transition: width 1.5s ease-in-out; height: 100%;
    }

    .modal-content {
      background: rgba(20, 20, 40, 0.95); backdrop-filter: blur(20px);
      border: 1px solid #0dcaf0; color: white;
    }
  </style>
</head>

<body>
  <div class="container-fluid py-2 no-print" style="background: rgba(0,0,0,0.3);">
    <div class="container d-flex justify-content-between align-items-center">
      <div class="d-flex align-items-center gap-3">
        <span class="text-light">
          مرحباً، <strong class="text-info"><%= user.name %></strong>
          <span class="badge bg-secondary ms-1 small"><%= user.role==='admin' ? 'مدير' : 'موظف' %></span>
        </span>
        <a href="/logout" class="btn btn-sm btn-outline-danger"><i class="fas fa-sign-out-alt"></i> خروج</a>
      </div>
      <div class="d-flex gap-2">
          <a href="/inventory-monitoring" class="btn btn-sm btn-success rounded-pill px-3">مراقبة الجرد</a>
          <a href="/" class="btn btn-sm btn-outline-light rounded-pill px-3">الرئيسية</a>
      </div>
    </div>
  </div>

  <div class="container mt-4 pb-5">
    <div class="mb-4">
      <h2 class="text-info-custom fw-bold"><i class="fas fa-boxes me-2"></i> جرد السيارات المتاحة</h2>
      <p class="text-white-50 small mb-0">السيارات التي لم يتم تحصيل كامل قيمتها تظهر هنا فقط</p>
    </div>

    <div class="glass-card mb-4 shadow-lg">
      <div class="card-body p-4">
        <h5 class="text-info-custom mb-3 small"><i class="fas fa-plus-circle me-1"></i> إضافة سيارة جديدة</h5>
        <form action="/add-car" method="POST" class="row g-3">
          <div class="col-md-3">
            <label class="small text-white-50">البراند</label>
            <input type="text" name="brand" class="form-control" required>
          </div>
          <div class="col-md-3">
            <label class="small text-white-50">الموديل</label>
            <input type="text" name="model" class="form-control" required>
          </div>
          <div class="col-md-2">
            <label class="small text-white-50">السنة</label>
            <input type="number" name="year" class="form-control" required>
          </div>
          <div class="col-md-2">
            <label class="small text-white-50">رقم الشاسيه</label>
            <input type="text" name="chassis" class="form-control" required>
          </div>
          <div class="col-md-2">
            <label class="small text-white-50">السعر</label>
            <input type="number" name="price" class="form-control" required>
          </div>
          <div class="col-md-12 text-end">
            <button type="submit" class="btn btn-info px-5 fw-bold mt-2">إضافة للجرد</button>
          </div>
        </form>
      </div>
    </div>

    <div class="glass-card shadow-lg overflow-hidden">
      <div class="table-responsive">
        <table class="table align-middle text-center mb-0">
          <thead>
            <tr>
              <th class="py-3">السيارة</th>
              <th>الشاسيه</th>
              <th>الوضع المالي</th>
              <th>نسبة التحصيل</th>
              <th>العمليات</th>
            </tr>
          </thead>
          <tbody>
            <% if (cars.length === 0) { %>
              <tr>
                <td colspan="5" class="py-5 text-white-50">الجرد فارغ حالياً (كل السيارات مباعة أو لم تضف بعد).</td>
              </tr>
            <% } %>
            <% cars.forEach(car => { 
                let p = parseFloat(car.price) || 0;
                let d = parseFloat(car.paid) || 0;
                let r = p - d;
                let percent = p > 0 ? (d / p) * 100 : 0;
                if(percent > 100) percent = 100;
            %>
              <tr>
                <td class="text-start ps-4">
                  <div class="fw-bold"><%= car.brand %></div>
                  <div class="text-info-custom small"><%= car.model %> - <%= car.year %></div>
                </td>
                <td><span class="badge bg-secondary font-monospace"><%= car.chassis %></span></td>
                <td class="text-start ps-3">
                  <div class="small">السعر: <%= p.toLocaleString() %></div>
                  <div class="text-success-custom fw-bold small">المدفوع: <%= d.toLocaleString() %></div>
                  <div class="text-danger-custom fw-bold small">المتبقي: <%= (r > 0 ? r : 0).toLocaleString() %></div>
                </td>
                <td style="min-width: 150px;">
                  <div class="progress">
                    <div class="progress-bar progress-bar-neon" role="progressbar" 
                         id="bar-<%= car.id %>" style="width: 0%;"></div>
                  </div>
                  <script>
                    setTimeout(() => {
                      const b = document.getElementById('bar-<%= car.id %>');
                      if(b) b.style.width = '<%= percent %>%';
                    }, 300);
                  </script>
                  <small class="text-info-custom"><%= percent.toFixed(0) %>% تم تحصيله</small>
                </td>
                <td>
                  <button class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#sellModal<%= car.id %>">
                    <i class="fas fa-check"></i> إتمام بيع
                  </button>
                  
                  <div class="modal fade" id="sellModal<%= car.id %>" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                      <div class="modal-content">
                        <div class="modal-header">
                          <h5 class="modal-title">تأكيد بيع: <%= car.brand %></h5>
                          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                        </div>
                        <form action="/finance/add-sale-invoice" method="POST">
                          <div class="modal-body text-start">
                            <input type="hidden" name="carId" value="<%= car.id %>">
                            <div class="mb-3">
                              <label class="small text-white-50">اسم العميل</label>
                              <input type="text" name="customerName" class="form-control" required>
                            </div>
                            <div class="mb-3">
                              <label class="small text-white-50">سعر البيع النهائي</label>
                              <input type="number" name="sellPrice" class="form-control" value="<%= car.price %>" required>
                            </div>
                          </div>
                          <div class="modal-footer border-0">
                            <button type="submit" class="btn btn-success w-100">تأكيد ونقل لمراقبة الجرد</button>
                          </div>
                        </form>
                      </div>
                    </div>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>