<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>تتبع الشحن | Al-Captin Shipping</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700;900&display=swap');

    body { background: #0f172a; color: white; font-family: 'Tajawal', sans-serif; }
    .glass-card { background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 28px; }
    .step-active { color: #3b82f6; position: relative; }
    .step-active::after { content: ''; position: absolute; bottom: -10px; left: 50%; transform: translateX(-50%); width: 10px; height: 10px; background: #3b82f6; border-radius: 50%; box-shadow: 0 0 15px #3b82f6; }
    .progress-line { height: 4px; background: rgba(255, 255, 255, 0.1); position: relative; overflow: hidden; }
    .progress-fill { height: 100%; background: linear-gradient(90deg, #3b82f6, #10b981); transition: 1s; }
    select option { background: #1e293b; color: white; }
    .swal2-popup-custom { border-radius: 24px !important; border: 1px solid rgba(255, 255, 255, 0.1) !important; font-family: 'Tajawal', sans-serif !important; }
  </style>
</head>

<body class="p-4 md:p-10">
  <div class="max-w-7xl mx-auto">
    <div class="flex justify-between items-center mb-10">
      <h1 class="text-3xl font-black border-r-8 border-emerald-500 pr-5 italic">لوحة متابعة شحن الحاويات</h1>
      <div class="flex gap-4">
          <a href="/archive" class="bg-purple-600/20 hover:bg-purple-600/40 text-purple-400 px-6 py-2 rounded-full text-sm font-bold transition border border-purple-500/30">الأرشيف</a>
          <a href="/" class="bg-white/10 hover:bg-white/20 px-6 py-2 rounded-full text-sm font-bold transition border border-white/10">العودة للرئيسية</a>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-8">
      <% if (shippingContracts && shippingContracts.length > 0) { %>
      <% shippingContracts.forEach(c => { %>
      <div class="glass-card p-8 shadow-2xl border-t-4 border-blue-500 mb-6">
        <div class="flex flex-col md:flex-row justify-between items-start mb-8 gap-4">
          <div>
            <h2 class="text-2xl font-black text-blue-400"><%= c.name %></h2>
            <p class="text-gray-500 font-bold text-sm">كود التعاقد: <%= c.id %></p>
          </div>
          <div class="bg-white/5 p-4 rounded-2xl border border-white/5 text-center min-w-[200px]">
            <div class="text-[10px] text-gray-500 mb-1 font-bold uppercase tracking-wider">الوصول المتوقع خلال</div>
            <div class="text-2xl font-mono font-black text-emerald-400" id="timer-<%= c.id %>">-- يوم : -- ساعة</div>
          </div>
        </div>

        <div class="relative mb-12 mt-10 px-4">
          <div class="progress-line rounded-full">
            <div class="progress-fill" style="width: <%= c.ship_stage == 'shipped' ? '25%' : c.ship_stage == 'at_sea' ? '50%' : c.ship_stage == 'customs' ? '75%' : '100%' %>"></div>
          </div>
          <div class="flex justify-between mt-6 text-[10px] md:text-sm font-bold">
            <div class="<%= c.ship_stage == 'shipped' ? 'step-active' : 'text-gray-600' %> text-center">
              <i class="fas fa-box-open text-xl mb-2"></i><br>بدء الشحن
            </div>
            <div class="<%= c.ship_stage == 'at_sea' ? 'step-active' : 'text-gray-600' %> text-center">
              <i class="fas fa-ship text-xl mb-2"></i><br>في عرض البحر
            </div>
            <div class="<%= c.ship_stage == 'customs' ? 'step-active' : 'text-gray-600' %> text-center">
              <i class="fas fa-warehouse text-xl mb-2"></i><br>الميناء/الجمارك
            </div>
            <div class="<%= c.ship_stage == 'delivered' ? 'step-active' : 'text-gray-600' %> text-center">
              <i class="fas fa-check-circle text-xl mb-2"></i><br>تم التسليم
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 bg-white/5 p-6 rounded-3xl border border-white/5">
          <div class="text-right">
            <span class="text-[10px] text-gray-500 block uppercase font-bold">السيارة</span>
            <b class="text-white text-lg"><%= c.brand %> <%= c.model %></b>
          </div>
          <div class="text-right">
            <span class="text-[10px] text-gray-500 block uppercase font-bold">مدة الشحن المتفق عليها</span>
            <b class="text-white text-lg"><%= c.ship_duration %> شهور</b>
          </div>
          <div class="text-right">
            <span class="text-[10px] text-gray-500 block uppercase font-bold">المتبقي المالي للتحصيل</span>
            <b class="text-yellow-500 text-lg">
              <%= (Number(c.remaining_final) || 0).toLocaleString() %> ج.م
            </b>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-white/10 grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="space-y-3">
            <label class="text-xs text-blue-400 font-black flex items-center gap-2">
              <i class="fas fa-map-marker-alt"></i> تحديث الموقع:
            </label>
            <div class="flex gap-2">
              <select id="stage-select-<%= c.id %>" class="bg-slate-800 border border-white/10 rounded-xl px-4 py-3 text-sm w-full outline-none focus:ring-2 focus:ring-blue-500 transition text-white">
                <option value="shipped" <%= c.ship_stage == 'shipped' ? 'selected' : '' %>>📦 تم شحن الحاوية</option>
                <option value="at_sea" <%= c.ship_stage == 'at_sea' ? 'selected' : '' %>>🚢 الحاوية في عرض البحر</option>
                <option value="customs" <%= c.ship_stage == 'customs' ? 'selected' : '' %>>🏢 الميناء / الجمارك</option>
                <option value="delivered" <%= c.ship_stage == 'delivered' ? 'selected' : '' %>>✅ تم تسليم العميل</option>
              </select>
              <button onclick="updateShipStage('<%= c.id %>')" class="bg-blue-600 hover:bg-blue-500 px-6 rounded-xl transition text-white"><i class="fas fa-save"></i></button>
            </div>
          </div>

          <div class="space-y-3">
            <label class="text-xs text-emerald-400 font-black flex items-center gap-2">
              <i class="fas fa-money-bill-wave"></i> تحصيل مالي (متعدد العملات):
            </label>
            <div class="flex flex-col gap-2 bg-black/20 p-4 rounded-2xl border border-white/5">
                <div class="flex gap-2">
                    <select id="pay-currency-<%= c.id %>" onchange="updateExchangeRate('<%= c.id %>')" class="bg-slate-800 border border-white/10 rounded-xl px-2 py-3 text-xs text-white">
                        <option value="egp" data-rate="1">ج.م (مصري)</option>
                        <option value="dollar" data-rate="<%= c.liveRates.dollar %>">USD (دولار)</option>
                        <option value="euro" data-rate="<%= c.liveRates.euro %>">EUR (يورو)</option>
                        <option value="won" data-rate="<%= c.liveRates.won %>">KRW (وون كوري)</option>
                        <option value="dirham" data-rate="<%= c.liveRates.dirham %>">AED (درهم)</option>
                    </select>
                    <input type="number" id="pay-amount-<%= c.id %>" placeholder="المبلغ" class="bg-slate-800 border border-white/10 rounded-xl px-4 py-3 text-sm flex-1 text-white">
                    
                    <input type="number" id="pay-rate-<%= c.id %>" value="1" class="hidden bg-slate-900 border border-white/10 rounded-xl px-3 py-3 text-xs w-20 text-emerald-400 font-bold" title="سعر الصرف المعتمد">
                </div>
                
                <div class="flex items-center gap-2">
                    <input type="file" id="pay-photo-<%= c.id %>" accept="image/*" class="text-xs text-gray-400 file:bg-blue-600 file:text-white file:border-none file:px-3 file:py-1 file:rounded-lg file:ml-2">
                    <button onclick="smartPay('<%= c.id %>', '<%= c.name %>')" class="bg-emerald-600 hover:bg-emerald-500 px-4 py-3 rounded-xl transition font-bold text-xs flex-1 text-white">تأكيد الدفع</button>
                </div>
            </div>
          </div>
        </div>
      </div>

      <script>
        (function() {
          const startStr = "<%= c.ship_start_date %>";
          if (!startStr) return;
          const targetDate = new Date(startStr);
          targetDate.setMonth(targetDate.getMonth() + <%= Number(c.ship_duration) %>);
          function updateTimer() {
            const diff = targetDate - new Date();
            const timerEl = document.getElementById("timer-<%= c.id %>");
            if (!timerEl) return;
            if (diff <= 0) { timerEl.innerText = "وصلت الشحنة"; timerEl.classList.add("text-emerald-300"); return; }
            const days = Math.floor(diff / 86400000);
            const hours = Math.floor((diff % 86400000) / 3600000);
            timerEl.innerText = `${days} يوم : ${hours} ساعة`;
          }
          setInterval(updateTimer, 60000); updateTimer();
        })();
      </script>
      <% }) %>
      <% } else { %>
      <div class="text-center p-20 glass-card">
        <i class="fas fa-anchor text-6xl text-gray-700 mb-6"></i>
        <p class="text-xl text-gray-500 font-bold italic">لا توجد سيارات في مرحلة الشحن حالياً</p>
      </div>
      <% } %>
    </div>
  </div>

  <script>
    // وظيفة تحديث سعر الصرف فور اختيار العملة
    function updateExchangeRate(id) {
        const select = document.getElementById(`pay-currency-${id}`);
        const rateInput = document.getElementById(`pay-rate-${id}`);
        const selectedOption = select.options[select.selectedIndex];
        const currentRate = selectedOption.getAttribute('data-rate');
        
        rateInput.value = currentRate;

        // إخفاء حقل السعر لو العملة جنيه مصري
        if (select.value === "egp") {
            rateInput.classList.add('hidden');
        } else {
            rateInput.classList.remove('hidden');
        }
    }

    async function updateShipStage(id) {
      const stage = document.getElementById(`stage-select-${id}`).value;
      const res = await fetch('/shipping/update-stage', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, stage })
      });
      const data = await res.json();
      if (data.success) {
        Swal.fire({ icon: 'success', title: 'تم التحديث', background: '#1e293b', color: '#fff' }).then(() => location.reload());
      } else {
        Swal.fire({ icon: 'error', title: 'عذراً!', text: data.error, background: '#1e293b', color: '#fff' });
      }
    }

    async function smartPay(id, customerName) {
      const amount = document.getElementById(`pay-amount-${id}`).value;
      const rate = document.getElementById(`pay-rate-${id}`).value;
      const photoInput = document.getElementById(`pay-photo-${id}`);
      const select = document.getElementById(`pay-currency-${id}`);
      const currencyName = select.options[select.selectedIndex].text;

      if (!amount || amount <= 0 || !photoInput.files[0]) {
        return Swal.fire({ icon: 'warning', title: 'تنبيه', text: 'برجاء إدخال المبلغ وإرفاق صورة الإيصال', background: '#1e293b', color: '#fff' });
      }

      // حساب القيمة التقريبية بالمصري للعرض فقط في التنبيه
      const totalInEgp = (amount * rate).toLocaleString();

      Swal.fire({
        title: 'تأكيد السداد',
        html: `سيتم تسجيل مبلغ <b>${amount} ${currencyName}</b> <br> ما يعادل تقريباً <b>${totalInEgp} ج.م</b> <br> للعميل: ${customerName}`,
        showCancelButton: true,
        confirmButtonText: 'نعم، إتمام الدفع',
        cancelButtonText: 'إلغاء',
        background: '#0f172a',
        color: '#fff'
      }).then(async (result) => {
        if (result.isConfirmed) {
          const formData = new FormData();
          formData.append('id', id);
          formData.append('amount', amount);
          formData.append('rate', rate);
          formData.append('photos', photoInput.files[0]);

          try {
            const res = await fetch('/shipping/pay-partial', { method: 'POST', body: formData });
            const data = await res.json();
            if (data.success) {
              Swal.fire({ icon: 'success', title: 'تم الحفظ بنجاح', background: '#1e293b', color: '#fff' }).then(() => location.reload());
            } else {
              Swal.fire({ icon: 'error', title: 'خطأ', text: data.error, background: '#1e293b', color: '#fff' });
            }
          } catch (e) {
            Swal.fire({ icon: 'error', title: 'خطأ اتصال بالخادم', background: '#1e293b', color: '#fff' });
          }
        }
      });
    }
  </script>
</body>
</html>