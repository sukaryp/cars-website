<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>مراقب النظام الشامل | تقارير الأداء المالي</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --glass-bg: rgba(255, 255, 255, 0.05);
            --glass-border: rgba(255, 255, 255, 0.1);
        }

        body {
            background: #0f172a;
            color: #f8fafc;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
        }

        .glass-card {
            background: var(--glass-bg);
            backdrop-filter: blur(10px);
            border: 1px solid var(--glass-border);
            border-radius: 15px;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        }

        .stat-card {
            border-right: 5px solid;
            transition: transform 0.3s;
        }
        
        .stat-card:hover { transform: translateY(-5px); }

        .table-dark {
            --bs-table-bg: rgba(30, 41, 59, 0.8);
        }

        .btn-excel { background-color: #198754; color: white; border: none; }
        .btn-excel:hover { background-color: #157347; color: white; }

        @media print {
            .no-print { display: none !important; }
            body { background: white !important; color: black !important; }
            .glass-card { border: 1px solid #ddd !important; background: none !important; color: black !important; }
            .text-success, .text-danger { font-weight: bold !important; }
        }
    </style>
</head>

<body>
    <div class="d-flex align-items-center justify-content-between px-4 py-3 no-print border-bottom border-secondary mb-3">
        <div class="d-flex align-items-center gap-3">
            <span class="text-light">
                مرحباً، <strong class="text-info"><%= user && user.name ? user.name : 'المدير' %></strong>
                <span class="badge bg-secondary ms-1"><%= (user && user.role === 'admin') ? 'مدير' : 'موظف' %></span>
            </span>
            <a href="/logout" class="btn btn-sm btn-outline-danger"><i class="fas fa-sign-out-alt"></i> خروج</a>
        </div>
        <h2 class="h5 mb-0 text-info"><i class="fas fa-shield-halved me-2"></i> مراقب النظام المالي الشامل</h2>
    </div>

    <div class="container-fluid py-2">
        <div class="d-flex justify-content-between align-items-center mb-4 no-print px-2">
            <div class="d-flex gap-2">
                <button onclick="window.print()" class="btn btn-outline-light btn-sm"><i class="fas fa-print me-1"></i> طباعة PDF</button>
                <button onclick="exportExcel()" class="btn btn-excel btn-sm"><i class="fas fa-file-excel me-1"></i> تصدير Excel</button>
            </div>
            <a href="/" class="btn btn-outline-info btn-sm px-4">العودة للوحة التحكم</a>
        </div>

        <div class="glass-card p-3 mb-4 no-print border-info mx-2">
            <form id="filterForm" action="/reports" method="GET" class="row g-2 align-items-end">
                <div class="col-md-2">
                    <label class="small text-white-50">من تاريخ</label>
                    <input type="date" name="startDate" value="<%= filters.startDate || '' %>" class="form-control form-control-sm bg-dark text-white border-secondary">
                </div>
                <div class="col-md-2">
                    <label class="small text-white-50">إلى تاريخ</label>
                    <input type="date" name="endDate" value="<%= filters.endDate || '' %>" class="form-control form-control-sm bg-dark text-white border-secondary">
                </div>
                <div class="col-md-3">
                    <label class="small text-white-50">تصفية حسب الموظف</label>
                    <select name="userFilter" class="form-select form-select-sm bg-dark text-white border-secondary">
                        <option value="all">كل الموظفين</option>
                        <% employees.forEach(staff => { %>
                            <option value="<%= staff.name %>" <%= filters.userFilter === staff.name ? 'selected' : '' %>><%= staff.name %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-info btn-sm w-100 fw-bold">تطبيق الفلترة</button>
                    <a href="/reports" class="btn btn-outline-secondary btn-sm"><i class="fas fa-undo"></i></a>
                </div>
            </form>
        </div>

        <div class="row g-3 mb-4 px-2">
            <div class="col-md-3">
                <div class="glass-card p-3 stat-card border-warning">
                    <span class="text-white-50 d-block mb-1 small">النقدية المتوفرة (الدرج)</span>
                    <h3 class="mb-0 text-warning"><%= (drawerCash || 0).toLocaleString() %> <small class="h6">ج.م</small></h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="glass-card p-3 stat-card border-success">
                    <span class="text-white-50 d-block mb-1 small">صافي الربح (بعد المصاريف)</span>
                    <h3 class="mb-0 text-success"><%= (netProfit || 0).toLocaleString() %> <small class="h6">ج.م</small></h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="glass-card p-3 stat-card border-danger">
                    <span class="text-white-50 d-block mb-1 small">إجمالي السُلف المعلقة</span>
                    <h3 class="mb-0 text-danger"><%= (totalLoans || 0).toLocaleString() %> <small class="h6">ج.م</small></h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="glass-card p-3 stat-card border-info">
                    <span class="text-white-50 d-block mb-1 small">سيارات متوفرة بالجرد</span>
                    <h3 class="mb-0 text-info"><%= inventoryCount || 0 %> <small class="h6">سيارة</small></h3>
                </div>
            </div>
        </div>

        <div class="row g-4 px-2">
            <div class="col-lg-8">
                <div class="glass-card p-4 h-100">
                    <h5 class="mb-4 text-white"><i class="fas fa-car me-2"></i> سجل أرباح مبيعات السيارات</h5>
                    <div class="table-responsive">
                        <table class="table table-dark table-hover align-middle text-center">
                            <thead class="table-light text-dark">
                                <tr>
                                    <th>السيارة / الشاسيه</th>
                                    <th>تكلفة الشراء</th>
                                    <th>سعر البيع</th>
                                    <th>صافي الربح</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (typeof carProfits !== 'undefined' && carProfits.length > 0) { %>
                                    <% carProfits.forEach(car => { %>
                                        <tr>
                                            <td class="text-start ps-3">
                                                <strong><%= car.type %></strong><br>
                                                <small class="text-info"><%= car.chassis %></small>
                                            </td>
                                            <td class="fw-bold"><%= (car.cost || car.totalCost || 0).toLocaleString() %></td>
                                            <td class="fw-bold"><%= (car.sellingPrice || 0).toLocaleString() %></td>
                                            <td class="text-success fw-bold">
                                                <span class="badge bg-success-subtle text-success px-3">
                                                    + <%= (car.profit || 0).toLocaleString() %>
                                                </span>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr><td colspan="4" class="py-5 text-white-50">لا توجد مبيعات مسجلة في هذه الفترة</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="glass-card p-4 mb-4 border-danger">
                    <h5 class="mb-3 text-white"><i class="fas fa-wallet me-2"></i> ملخص المصاريف والخصومات</h5>
                    <ul class="list-group list-group-flush bg-transparent">
                        <li class="list-group-item bg-transparent text-white d-flex justify-content-between px-0">
                            <span>المصاريف العامة:</span>
                            <span class="text-danger fw-bold"><%= (totalGeneralExpenses || 0).toLocaleString() %></span>
                        </li>
                        <li class="list-group-item bg-transparent text-white d-flex justify-content-between px-0">
                            <span>الرواتب المدفوعة:</span>
                            <span class="text-danger fw-bold"><%= (totalSalaries || 0).toLocaleString() %></span>
                        </li>
                        <li class="list-group-item bg-transparent text-white d-flex justify-content-between px-0 border-0">
                            <span>الخصومات (مكسب):</span>
                            <span class="text-success fw-bold">+ <%= (totalPenalties || 0).toLocaleString() %></span>
                        </li>
                    </ul>
                </div>

                <div class="glass-card p-4 border-info">
                    <h6 class="text-info"><i class="fas fa-clock me-1"></i> حالة النظام الحالية</h6>
                    <p class="small mb-0 text-white-50">
                        آخر تحديث للبيانات: <br>
                        <strong class="text-white"><%= lastUpdate %></strong><br><br>
                        <i class="fas fa-check-circle text-success me-1"></i> البيانات مربوطة بالجرد والمصاريف لحظياً.
                    </p>
                </div>
            </div>

            <div class="col-12 mb-5">
                <div class="glass-card p-4 mt-2">
                    <h5 class="text-white mb-3"><i class="fas fa-users me-2"></i> مراقبة حركة الموظفين والرواتب</h5>
                    <div class="table-responsive">
                        <table class="table table-dark table-hover border-secondary text-center">
                            <thead class="table-light text-dark">
                                <tr>
                                    <th>الموظف</th>
                                    <th>المرتب الأساسي</th>
                                    <th>السُلف</th>
                                    <th>الخصومات</th>
                                    <th>صافي المستحق</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (employees && employees.length > 0) { 
                                    employees.forEach(emp => { 
                                        const empLoans = expenses.filter(ex => ex.category === "سلفة" && ex.reason && ex.reason.includes(emp.name)).reduce((s, ex) => s + (Number(ex.amount) || 0), 0);
                                        const empPenalties = expenses.filter(ex => ex.category === "خصم" && ex.reason && ex.reason.includes(emp.name)).reduce((s, ex) => s + (Number(ex.amount) || 0), 0);
                                %>
                                    <tr>
                                        <td class="text-info fw-bold"><%= emp.name %><br><small class="text-white-50"><%= emp.position %></small></td>
                                        <td><%= (Number(emp.salary) || 0).toLocaleString() %></td>
                                        <td class="text-danger"><%= empLoans.toLocaleString() %></td>
                                        <td class="text-warning"><%= empPenalties.toLocaleString() %></td>
                                        <td class="bg-primary-subtle text-primary fw-bold">
                                            <%= (Number(emp.salary) - empLoans - empPenalties).toLocaleString() %> ج.م
                                        </td>
                                    </tr>
                                <% })} else { %>
                                    <tr><td colspan="5" class="py-3 text-white-50">لا يوجد بيانات موظفين</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function exportExcel() {
            const params = new URLSearchParams(new FormData(document.getElementById('filterForm')));
            window.location.href = '/reports/export?' + params.toString();
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <%- include('partials/signature') %>
</body>
</html>