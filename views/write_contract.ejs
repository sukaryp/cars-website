<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <title>طباعة عقد اتفاق - الكابتن لاستيراد السيارات</title>
    <style>
        @page {
            size: A4;
            margin: 0;
        }

        body {
            margin: 0;
            padding: 0;
            background: #333;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .contract-paper {
            width: 210mm;
            height: 297mm;
            margin: 20px auto;
            position: relative;
            background-color: white;
            background-image: url('/my_contract.jpg');
            background-size: 100% 100%;
            background-repeat: no-repeat;
        }

        /* تنسيق الخانات الشفافة */
        .field {
            position: absolute;
            background: transparent;
            border: none;
            outline: none;
            font-size: 14px;
            /* حجم الخط مناسب لعقدك */
            font-weight: bold;
            color: #000;
            font-family: 'Arial', sans-serif;
        }

        /* عند الكتابة يظهر لون خفيف جداً للتوجيه فقط */
        .field:focus {
            background: rgba(0, 212, 255, 0.05);
        }

        @media print {
            .no-print {
                display: none;
            }

            body {
                background: white;
            }

            .contract-paper {
                margin: 0;
                box-shadow: none;
            }
        }

        /* ---------------------------------------------------------
           تنسيق أماكن الخانات بناءً على صورة عقد "الكابتن"
           --------------------------------------------------------- */

        /* التاريخ واليوم */
        #day_name {
            top: 185px;
            right: 155px;
            width: 80px;
        }

        #contract_date {
            top: 185px;
            right: 290px;
            width: 120px;
        }

        /* الطرف الثاني (العميل) */
        #client_name {
            top: 224px;
            right: 160px;
            width: 280px;
        }

        #client_id {
            top: 224px;
            right: 540px;
            width: 150px;
        }

        #client_phone {
            top: 242px;
            right: 160px;
            width: 180px;
        }

        #client_address {
            top: 242px;
            right: 490px;
            width: 200px;
        }

        /* بيانات السيارة */
        #car_brand {
            top: 260px;
            right: 140px;
            width: 100px;
        }

        #car_model {
            top: 260px;
            right: 310px;
            width: 100px;
        }

        #car_year {
            top: 260px;
            right: 480px;
            width: 80px;
        }

        #car_color {
            top: 278px;
            right: 140px;
            width: 100px;
        }

        #car_style {
            top: 278px;
            right: 310px;
            width: 100px;
        }

        #car_vin {
            top: 295px;
            right: 140px;
            width: 250px;
        }

        /* المبالغ المالية */
        #total_price {
            top: 312px;
            right: 525px;
            width: 100px;
        }

        #deposit {
            top: 332px;
            right: 525px;
            width: 100px;
        }

        #remaining {
            top: 350px;
            right: 525px;
            width: 100px;
        }

        /* الملاحظات */
        #note_1 {
            top: 408px;
            right: 150px;
            width: 450px;
        }

        #note_2 {
            top: 430px;
            right: 150px;
            width: 450px;
        }

        #note_3 {
            top: 452px;
            right: 150px;
            width: 450px;
        }
    </style>
</head>

<body>
    <div class="d-flex align-items-center gap-3 no-print">
        <span class="text-light">
            مرحباً، <strong class="text-info">
                <%= user.name %>
            </strong>
            <span class="badge bg-secondary ms-1">
                <%= user.role==='admin' ? 'مدير' : 'موظف' %>
            </span>
        </span>
        <a href="/logout" class="btn btn-sm btn-outline-danger">
            <i class="fas fa-sign-out-alt"></i> خروج
        </a>
    </div>

    <div class="no-print"
        style="position: sticky; top:0; background: #000; color: #fff; padding: 10px; text-align: center; z-index: 100;">
        <button onclick="window.print()"
            style="padding: 8px 30px; background: #28a745; color: white; border: none; cursor: pointer; font-weight: bold; border-radius: 5px;">طباعة
            العقد</button>
        <p style="margin: 5px 0 0 0; font-size: 12px; color: #ccc;">املأ الخانات واضغط طباعة (تأكد أن الصورة باسم
            my_contract.jpg في folder public)</p>
    </div>

    <div class="contract-paper">
        <input type="text" id="contract_date" class="field" value="<%= c.date || '' %>">

        <input type="text" id="client_name" class="field" value="<%= c.customerName || '' %>">
        <input type="text" id="client_phone" class="field" value="<%= c.customerPhone || '' %>">

        <input type="text" id="car_brand" class="field" value="<%= c.brand || '' %>">
        <input type="text" id="car_model" class="field" value="<%= c.carModel || '' %>">
        <input type="text" id="car_vin" class="field" value="<%= c.chassis || '' %>">

        <input type="text" id="total_price" class="field" value="<%= c.totalPrice || '' %>">
        <input type="text" id="deposit" class="field" value="<%= c.amount || '' %>">
    </div>
    <%- include('partials/signature') %>

</body>

</html>