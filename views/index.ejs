<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>القيادة المركزية | Al Captain Motors</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --glass-bg: rgba(255, 255, 255, 0.08);
            --glass-border: rgba(255, 255, 255, 0.15);
            --ios-blue: #0A84FF;
            --ios-green: #30D158;
            --ios-red: #FF453A;
            --ios-orange: #FF9F0A;
            --deep-space: #000000;
        }

        body {
            background-color: var(--deep-space);
            color: #ffffff;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }

        /* خلفية السيارة - iOS Style */
        .cyber-car-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -2;
            opacity: 0.3;
            pointer-events: none;
        }

        .cyber-car-bg img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: saturate(1.2) brightness(0.6);
        }

        .bg-overlay-dark {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(180deg, rgba(0,0,0,0.2) 0%, #000 100%);
            z-index: -1;
            pointer-events: none;
        }

        /* هيدر مستوحى من بار الأيفون */
        .user-bar {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(25px) saturate(180%);
            -webkit-backdrop-filter: blur(25px) saturate(180%);
            border-bottom: 0.5px solid var(--glass-border);
            padding: 12px 0;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        /* كروت الأرقام العلوية (iOS Widgets) */
        .profit-header {
            background: var(--glass-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 22px; /* انحناء أبل الشهير */
            padding: 20px;
            transition: 0.3s;
        }

        .profit-header h2 {
            font-size: 1.8rem;
            letter-spacing: -0.5px;
            font-weight: 600;
        }

        /* شبكة التطبيقات (Grid Icons) */
        .glass-card {
            background: var(--glass-bg);
            backdrop-filter: blur(30px) saturate(150%);
            -webkit-backdrop-filter: blur(30px) saturate(150%);
            border: 1px solid var(--glass-border);
            border-radius: 28px; /* شكل الأيقونات في الـ iOS */
            padding: 25px;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            transition: all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
            text-decoration: none !important;
            color: #ffffff !important;
        }

        .glass-card:hover {
            background: rgba(255, 255, 255, 0.15);
            transform: scale(1.03);
            border-color: rgba(255, 255, 255, 0.4);
        }

        .glass-card i {
            font-size: 2.5rem;
            margin-bottom: 15px;
            filter: drop-shadow(0 0 8px rgba(255,255,255,0.2));
        }

        .main-title {
            font-weight: 700;
            letter-spacing: -1px;
            background: #ffffff;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .stat-number {
            font-size: 0.75rem;
            font-weight: 500;
            color: rgba(255, 255, 255, 0.5);
            text-transform: uppercase;
            margin-top: 10px;
        }

        /* ألوان أيقونات الـ iOS */
        .icon-blue { color: var(--ios-blue); }
        .icon-green { color: var(--ios-green); }
        .icon-orange { color: var(--ios-orange); }
        .icon-red { color: var(--ios-red); }
        .icon-purple { color: #BF5AF2; }

        /* الأنيميشن الناعم */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .container { animation: fadeIn 0.8s ease-out; }

    </style>
</head>

<body>
    <div class="cyber-car-bg">
        <img src="https://media.giphy.com/media/v1.Y2lkPTc5MGI3NjExbnYybHdyNmV0M3N6Zndidm16Z3BwZTVwaXB6Ym43ZzR6ZXZ6Zndidm16Z3BwZSZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9Zw/Lp88vSj4Xj162Y963v/giphy.gif" alt="Mercedes Vision Future">
    </div>
    <div class="bg-overlay-dark"></div>

    <nav class="user-bar no-print">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle" style="width: 38px; height: 38px; background: var(--ios-blue); display: flex; align-items: center; justify-content: center; box-shadow: 0 0 15px rgba(10,132,255,0.4)">
                    <i class="fas fa-user text-white"></i>
                </div>
                <span>
                    <strong style="font-weight: 600;"><%= user.name %></strong>
                    <span class="ms-2 badge rounded-pill bg-white text-dark" style="font-size: 10px; opacity: 0.8;">
                        <%= user.role==='admin' ? 'ADMIN' : 'USER' %>
                    </span>
                </span>
            </div>
            <a href="/logout" class="btn btn-sm btn-link text-danger text-decoration-none fw-bold" style="font-size: 13px;">خروج من النظام</a>
        </div>
    </nav>

    <div class="container py-5">
        <div class="text-center mb-5">
            <h1 class="display-4 main-title mb-1">Al Captain Motors</h1>
            <p style="color: rgba(255,255,255,0.5); font-weight: 400; letter-spacing: 2px;">DASHBOARD CENTRAL</p>
        </div>

        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="profit-header text-center">
                    <small class="text-white-50 d-block mb-1">السيولة (EGP)</small>
                    <h2 class="icon-blue m-0"><%= balanceEGP.toLocaleString() %></h2>
                </div>
            </div>
            <div class="col-md-4">
                <div class="profit-header text-center">
                    <small class="text-white-50 d-block mb-1">احتياطي (USD)</small>
                    <h2 class="icon-green m-0"><%= balanceUSD.toLocaleString() %></h2>
                </div>
            </div>
            <div class="col-md-4">
                <div class="profit-header text-center">
                    <small class="text-white-50 d-block mb-1">رصيد (EUR)</small>
                    <h2 class="icon-orange m-0"><%= balanceEUR.toLocaleString() %></h2>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-6 col-md-4 col-lg-3">
                <a href="/bank-transfers" class="glass-card">
                    <i class="fas fa-university icon-blue"></i>
                    <h6 class="fw-bold m-0">البنك</h6>
                    <div class="stat-number">Transfers</div>
                </a>
            </div>

            <div class="col-6 col-md-4 col-lg-3">
                <a href="/expenses" class="glass-card">
                    <i class="fas fa-wallet icon-green"></i>
                    <h6 class="fw-bold m-0">الخزنة</h6>
                    <div class="stat-number">Cash Core</div>
                </a>
            </div>

            <div class="col-6 col-md-4 col-lg-3">
                <a href="/employees" class="glass-card">
                    <i class="fas fa-users icon-purple"></i>
                    <h6 class="fw-bold m-0">الموظفين</h6>
                    <div class="stat-number">Staff Bio</div>
                </a>
            </div>

            <div class="col-6 col-md-4 col-lg-3">
                <a href="/cars" class="glass-card">
                    <i class="fas fa-car icon-blue"></i>
                    <h6 class="fw-bold m-0">السيارات</h6>
                    <div class="stat-number"><%= carsCount %> UNITS</div>
                </a>
            </div>

            <div class="col-6 col-md-4 col-lg-3">
                <a href="/import" class="glass-card">
                    <i class="fas fa-ship icon-orange"></i>
                    <h6 class="fw-bold m-0">الاستيراد</h6>
                    <div class="stat-number"><%= importsCount %> CARGO</div>
                </a>
            </div>

            <div class="col-6 col-md-4 col-lg-3">
                <a href="/contracts" class="glass-card">
                    <i class="fas fa-file-signature icon-red"></i>
                    <h6 class="fw-bold m-0">العقود</h6>
                    <div class="stat-number">Protocols</div>
                </a>
            </div>

            <div class="col-6 col-md-4 col-lg-3">
                <a href="/cash-payments" class="glass-card">
                    <i class="fas fa-bolt icon-green"></i>
                    <h6 class="fw-bold m-0">دفع كاش</h6>
                    <div class="stat-number">Payments</div>
                </a>
            </div>

            <div class="col-6 col-md-4 col-lg-3">
                <a href="/reports" class="glass-card">
                    <i class="fas fa-chart-pie icon-purple"></i>
                    <h6 class="fw-bold m-0">التقارير</h6>
                    <div class="stat-number">Analytics</div>
                </a>
            </div>

            <div class="col-6 col-md-4 col-lg-3">
                <a href="/purchase-invoices" class="glass-card">
                    <i class="fas fa-file-invoice-dollar icon-orange"></i>
                    <h6 class="fw-bold m-0">المشتريات</h6>
                    <div class="stat-number">Invoices</div>
                </a>
            </div>

            <% if (user.role==='admin' ) { %>
            <div class="col-6 col-md-4 col-lg-3">
                <a href="/admin/users" class="glass-card">
                    <i class="fas fa-cog text-white-50"></i>
                    <h6 class="fw-bold m-0">الإعدادات</h6>
                    <div class="stat-number">System Admin</div>
                </a>
            </div>
            <% } %>
        </div>

        <div class="text-center mt-5">
            <p style="color: rgba(255,255,255,0.2); font-size: 11px; font-weight: 500;">DESIGNED FOR CAPTAIN MOTORS IN CUPERTINO</p>
        </div>
    </div>

    <%- include('partials/signature') %>
</body>
</html>