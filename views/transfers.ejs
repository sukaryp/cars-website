<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>خزينة الكابتن | الموقف المالي</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;500;700;900&display=swap" rel="stylesheet">
    <style>
        body { 
            font-family: 'Tajawal', sans-serif; 
            background-color: #f8fafc; 
            color: #1e293b;
        }
        .glass-header {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
        }
        .stat-card {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border: 1px solid rgba(226, 232, 240, 0.8);
        }
        .stat-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
        }
        .currency-badge {
            letter-spacing: 1px;
            font-size: 0.7rem;
        }
    </style>
</head>
<body class="p-4 md:p-10">

    <div class="max-w-7xl mx-auto">
        <div class="flex flex-col md:flex-row justify-between items-center mb-10 gap-6 glass-header p-8 rounded-[2.5rem] shadow-sm border border-white">
            <div class="text-center md:text-right">
                <h1 class="text-4xl font-black text-slate-900 tracking-tight mb-1">إدارة الخزينة والدرج</h1>
                <p class="text-slate-500 font-medium text-lg">الرصيد الفعلي والتدفقات المالية للنظام</p>
            </div>
            <div class="flex gap-4">
                <button onclick="document.getElementById('addModal').classList.remove('hidden')" class="bg-emerald-600 text-white px-8 py-4 rounded-2xl font-bold hover:bg-emerald-700 transition-all shadow-lg shadow-emerald-200 flex items-center gap-3 text-lg">
                    <i class="fas fa-plus-circle"></i> حركة جديدة
                </button>
                <a href="/" class="bg-slate-800 text-white px-8 py-4 rounded-2xl font-bold hover:bg-slate-700 transition-all shadow-md flex items-center gap-3 text-lg">
                    <i class="fas fa-home"></i> الرئيسية
                </a>
            </div>
        </div>

        <% if (typeof lastContract !== 'undefined' && lastContract) { %>
        <div class="mb-10 bg-white p-6 rounded-[2rem] border-r-8 border-emerald-500 flex flex-col md:flex-row items-center justify-between gap-6 shadow-sm">
            <div class="flex items-center gap-5">
                <div class="w-14 h-14 bg-emerald-100 text-emerald-600 rounded-2xl flex items-center justify-center text-2xl">
                    <i class="fas fa-file-invoice-dollar"></i>
                </div>
                <div>
                    <p class="text-xs text-emerald-600 font-bold uppercase mb-1">آخر عملية تعاقد مسجلة</p>
                    <p class="text-xl font-bold text-slate-800">
                        العميل: <span class="text-emerald-700"><%= lastContract.name %></span> 
                        <span class="mx-3 text-slate-300">|</span> 
                        السيارة: <span class="text-slate-600"><%= lastContract.brand %> <%= lastContract.model %></span>
                    </p>
                </div>
            </div>
            <div class="bg-slate-50 px-8 py-3 rounded-2xl border border-slate-100 text-center">
                <p class="text-[11px] text-slate-400 font-bold mb-1">رقم المرجع</p>
                <p class="font-black text-slate-700 text-lg">#<%= lastContract.id %></p>
            </div>
        </div>
        <% } %>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
            <div class="stat-card bg-white p-8 rounded-[2.5rem] relative overflow-hidden">
                <div class="flex justify-between items-start mb-4">
                    <h3 class="text-slate-500 font-bold text-sm uppercase">الجنيه المصري</h3>
                    <span class="bg-emerald-100 text-emerald-700 px-3 py-1 rounded-full text-[10px] font-black tracking-widest uppercase">Active</span>
                </div>
                <div class="text-4xl font-black text-slate-900 mb-2">
                    <%= balances.EGP.toLocaleString() %> <span class="text-lg font-medium text-slate-400 ml-1">EGP</span>
                </div>
                <div class="flex items-center gap-2 text-emerald-500 text-sm font-bold">
                    <i class="fas fa-check-double"></i> الرصيد مطابق للدرج
                </div>
            </div>

            <div class="stat-card bg-white p-8 rounded-[2.5rem] relative overflow-hidden">
                <div class="flex justify-between items-start mb-4">
                    <h3 class="text-slate-500 font-bold text-sm uppercase">الدولار الأمريكي</h3>
                    <span class="bg-blue-100 text-blue-700 px-3 py-1 rounded-full text-[10px] font-black tracking-widest uppercase">Forex</span>
                </div>
                <div class="text-4xl font-black text-blue-600 mb-2">
                    <%= balances.USD.toLocaleString() %> <span class="text-lg font-medium text-slate-400 ml-1">USD</span>
                </div>
                <% if(balances.USD < 0) { %>
                    <div class="flex items-center gap-2 text-rose-500 text-sm font-bold animate-pulse">
                        <i class="fas fa-exclamation-triangle"></i> تنبيه: يوجد عجز مالي
                    </div>
                <% } else { %>
                    <div class="flex items-center gap-2 text-blue-400 text-sm font-bold">
                        <i class="fas fa-info-circle"></i> متوفر في الخزنة الحالية
                    </div>
                <% } %>
            </div>

            <div class="stat-card bg-white p-8 rounded-[2.5rem] relative overflow-hidden">
                <div class="flex justify-between items-start mb-4">
                    <h3 class="text-slate-500 font-bold text-sm uppercase">اليورو الأوروبي</h3>
                    <span class="bg-amber-100 text-amber-700 px-3 py-1 rounded-full text-[10px] font-black tracking-widest uppercase">Forex</span>
                </div>
                <div class="text-4xl font-black text-amber-600 mb-2">
                    <%= balances.EUR.toLocaleString() %> <span class="text-lg font-medium text-slate-400 ml-1">EUR</span>
                </div>
                <div class="flex items-center gap-2 text-amber-500 text-sm font-bold">
                    <i class="fas fa-coins"></i> جاهز لعمليات الشراء
                </div>
            </div>
        </div>

        <div class="bg-white rounded-[3rem] shadow-xl border border-slate-100 overflow-hidden">
            <div class="p-8 border-b border-slate-50 bg-slate-50/50 flex justify-between items-center">
                <h2 class="font-black text-slate-800 text-xl tracking-tight">سجل حركات الخزينة</h2>
                <div class="flex gap-2">
                    <span class="bg-white border border-slate-200 text-slate-600 px-4 py-1.5 rounded-xl text-xs font-bold shadow-sm">تحديث تلقائي</span>
                </div>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-right border-collapse">
                    <thead>
                        <tr class="bg-slate-900 text-white">
                            <th class="p-6 font-bold text-sm">تاريخ الحركة</th>
                            <th class="p-6 font-bold text-sm">النوع</th>
                            <th class="p-6 font-bold text-sm">البيان والتفاصيل</th>
                            <th class="p-6 font-bold text-sm text-center">العملة</th>
                            <th class="p-6 font-bold text-sm">القيمة والإجراء</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <% if (transactions && transactions.length > 0) { %>
                            <% transactions.forEach(tr => { %>
                                <tr class="hover:bg-slate-50/80 transition-all group">
                                    <td class="p-6">
                                        <div class="text-slate-900 font-bold text-base"><%= new Date(tr.date).toLocaleDateString('ar-EG') %></div>
                                        <div class="text-[10px] text-slate-400 font-medium uppercase"><%= new Date(tr.date).toLocaleTimeString('ar-EG', {hour: '2-digit', minute:'2-digit'}) %></div>
                                    </td>
                                    <td class="p-6">
                                        <span class="inline-flex items-center px-4 py-1.5 rounded-full text-xs font-black uppercase tracking-tighter bg-<%= tr.color %>-100 text-<%= tr.color %>-700">
                                            <span class="w-2 h-2 rounded-full bg-<%= tr.color %>-500 ml-2"></span>
                                            <%= tr.type %>
                                        </span>
                                    </td>
                                    <td class="p-6">
                                        <div class="text-slate-700 font-bold text-base"><%= tr.details %></div>
                                        <div class="text-xs text-slate-400 mt-1 font-medium">المرجع: <%= tr.ref %></div>
                                    </td>
                                    <td class="p-6 text-center">
                                        <span class="bg-slate-100 text-slate-800 px-4 py-1.5 rounded-xl text-xs font-black">
                                            <%= tr.currency %>
                                        </span>
                                    </td>
                                    <td class="p-6">
                                        <div class="flex items-center justify-between">
                                            <div class="text-2xl font-black <%= tr.color === 'emerald' ? 'text-emerald-600' : 'text-rose-600' %>">
                                                <%= tr.color === 'emerald' ? '+' : '-' %> <%= tr.amount.toLocaleString() %>
                                            </div>
                                            
                                            <% if (user.role === 'admin' && tr.canDelete) { %>
                                                <form action="/transfers/delete/<%= tr.id %>" method="POST" onsubmit="return confirm('هل أنت متأكد من حذف هذه الحركة نهائياً؟')">
                                                    <button type="submit" class="w-10 h-10 rounded-full bg-rose-50 text-rose-500 hover:bg-rose-500 hover:text-white transition-all flex items-center justify-center shadow-sm">
                                                        <i class="fas fa-trash-alt"></i>
                                                    </button>
                                                </form>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="p-32 text-center text-slate-400">
                                    <i class="fas fa-folder-open text-6xl mb-4 block opacity-20"></i>
                                    <p class="text-xl font-bold">لا توجد حركات نقدية مسجلة حالياً</p>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div id="addModal" class="fixed inset-0 bg-slate-900/80 backdrop-blur-md hidden flex items-center justify-center p-4 z-50">
        <div class="bg-white w-full max-w-xl rounded-[3rem] shadow-2xl overflow-hidden shadow-black/20 transition-all border border-white">
            <div class="bg-slate-900 p-10 text-white flex justify-between items-center">
                <div>
                    <h3 class="text-3xl font-black mb-1">تسجيل حركة</h3>
                    <p class="text-slate-400 font-medium">أضف بيانات العملية النقدية بدقة</p>
                </div>
                <button onclick="document.getElementById('addModal').classList.add('hidden')" class="w-12 h-12 flex items-center justify-center rounded-full bg-white/10 hover:bg-white/20 transition-all"><i class="fas fa-times text-xl"></i></button>
            </div>
            <form action="/transfers/add" method="POST" class="p-10 space-y-8">
                <div class="space-y-2">
                    <label class="block text-slate-700 font-bold text-base px-1">نوع العملية</label>
                    <select name="type" class="w-full bg-slate-50 border-2 border-slate-100 p-5 rounded-2xl font-bold focus:border-emerald-500 focus:bg-white outline-none transition-all text-lg">
                        <option value="deposit">إيداع (دخول مبالغ للدرج)</option>
                        <option value="withdraw">سحب (خروج مبالغ من الدرج)</option>
                    </select>
                </div>

                <div class="grid grid-cols-2 gap-6">
                    <div class="space-y-2">
                        <label class="block text-slate-700 font-bold text-base px-1">المبلغ</label>
                        <input type="number" name="amount" required step="0.01" class="w-full bg-slate-50 border-2 border-slate-100 p-5 rounded-2xl font-bold focus:border-emerald-500 focus:bg-white outline-none transition-all text-xl" placeholder="0.00">
                    </div>
                    <div class="space-y-2">
                        <label class="block text-slate-700 font-bold text-base px-1">العملة</label>
                        <select name="currency" class="w-full bg-slate-50 border-2 border-slate-100 p-5 rounded-2xl font-bold focus:border-emerald-500 focus:bg-white outline-none transition-all text-lg">
                            <option value="EGP">جنيه مصري (EGP)</option>
                            <option value="USD">دولار أمريكي (USD)</option>
                            <option value="EUR">يورو (EUR)</option>
                        </select>
                    </div>
                </div>

                <div class="space-y-2">
                    <label class="block text-slate-700 font-bold text-base px-1">البيان / تفاصيل العملية</label>
                    <textarea name="details" required class="w-full bg-slate-50 border-2 border-slate-100 p-5 rounded-2xl font-bold focus:border-emerald-500 focus:bg-white outline-none transition-all text-lg" placeholder="اكتب سبب الحركة هنا..." rows="3"></textarea>
                </div>

                <button type="submit" class="w-full bg-emerald-600 text-white py-6 rounded-3xl font-black hover:bg-emerald-700 transition-all shadow-xl shadow-emerald-100 text-xl uppercase tracking-wider">
                    تأكيد وحفظ العملية
                </button>
            </form>
        </div>
    </div>
</body>
</html>