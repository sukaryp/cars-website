<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة التحويلات البنكية | السلسلة العالمية</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background: linear-gradient(rgba(10, 25, 47, 0.9), rgba(10, 25, 47, 0.9)),
                url('https://images.unsplash.com/photo-1550565118-3a14e8d0386f?q=80&w=2070&auto=format&fit=crop');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            color: #fdfdfd;
            font-family: 'Segoe UI', sans-serif;
            min-height: 100vh;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        }

        .account-selection-card {
            cursor: pointer;
            transition: all 0.3s ease;
            border: 1px solid rgba(255, 255, 255, 0.1);
            background: rgba(255, 255, 255, 0.05);
        }

        .account-selection-card:hover {
            background: rgba(52, 152, 219, 0.2);
            transform: translateY(-5px);
            border-color: #3498db;
        }

        .form-control,
        .form-select {
            background: rgba(255, 255, 255, 0.9) !important;
            color: #000 !important;
            border: 1px solid #3498db;
            font-weight: 600;
            border-radius: 10px;
        }

        .table {
            color: #fff !important;
            border-color: rgba(255, 255, 255, 0.1);
        }

        .table thead {
            background: rgba(52, 152, 219, 0.2);
            color: #3498db;
        }

        .text-info-custom {
            color: #3498db !important;
        }

        .text-success-custom {
            color: #2ecc71 !important;
        }

        .badge-bank {
            background: rgba(52, 152, 219, 0.1);
            border: 1px solid rgba(52, 152, 219, 0.3);
            color: #3498db;
            padding: 5px 12px;
            border-radius: 8px;
        }

        .img-preview {
            width: 40px;
            height: 40px;
            object-fit: cover;
            border-radius: 5px;
            cursor: pointer;
            border: 1px solid #3498db;
        }

        tr:hover {
            background: rgba(255, 255, 255, 0.03);
            transition: 0.3s;
        }
    </style>
</head>

<body>
    <div class="d-flex align-items-center gap-3 no-print">
        <span class="text-light">
            مرحباً، <strong class="text-info">
                <%= user.name %>
            </strong>
            <span class="badge bg-secondary ms-1">
                <%= user.role==='admin' ? 'مدير' : 'موظف' %>
            </span>
        </span>
        <a href="/logout" class="btn btn-sm btn-outline-danger">
            <i class="fas fa-sign-out-alt"></i> خروج
        </a>
    </div>
    <div class="container mt-4 pb-5">
        <div class="d-flex justify-content-center mb-3">
            <div class="badge bg-dark border border-info p-2 px-4 shadow">
                <i class="fas fa-sync-alt fa-spin me-2 text-info"></i>
                سعر المركزي الآن:
                <span class="text-success mx-2">USD: <%= rates.USD %></span> |
                <span class="text-warning mx-2">EUR: <%= rates.EUR %></span>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="text-info-custom fw-bold"><i class="fas fa-university me-2"></i> التحويلات البنكية والمقاصة</h2>
            <a href="/" class="btn btn-outline-light rounded-pill px-4 shadow-sm">
                <i class="fas fa-home me-1"></i> الرئيسية
            </a>
        </div>

        <div class="glass-card mb-4 shadow-lg border-0">
            <div class="p-3 border-bottom border-secondary text-info-custom fw-bold">
                <i class="fas fa-plus-circle me-1"></i> تسجيل عملية إيداع / تحويل جديدة
            </div>
            <div class="card-body p-4">
                <form action="/add-transfer" method="POST" enctype="multipart/form-data" class="row g-3">
                    <div class="col-md-3">
                        <label>اختر السيارة المرتبطة بالتحويل:</label>
                        <select name="carId" class="form-control" required>
                            <option value="">-- اختر السيارة من الجرد --</option>
                            <% cars.forEach(car=> { %>
                                <option value="<%= car.id %>">
                                    <%= car.brand %> - شاسيه: <%= car.chassis %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small text-white-50">الحساب المستلم</label>
                        <div class="input-group">
                            <input type="text" id="selectedAccountDisplay" class="form-control"
                                placeholder="اضغط لاختيار الحساب" readonly data-bs-toggle="modal"
                                data-bs-target="#accountsModal" style="cursor: pointer; background: white !important;">
                            <input type="hidden" name="targetAccount" id="targetAccountValue" required>
                            <button class="btn btn-info" type="button" data-bs-toggle="modal"
                                data-bs-target="#accountsModal">
                                <i class="fas fa-search-dollar"></i>
                            </button>
                        </div>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small text-white-50">رقم المرجع (Ref)</label>
                        <input type="text" name="refNumber" class="form-control" placeholder="رقم العملية" required>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small text-white-50">المبلغ</label>
                        <input type="number" name="amount" id="amountInput" class="form-control" placeholder="0.00"
                            step="0.01" required>
                        <div id="conversionArea" class="mt-1 small fw-bold text-warning" style="display: none;">
                            ≈ <span id="egpResult">0</span> ج.م
                        </div>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small text-white-50">العملة</label>
                        <select name="currency" id="currencySelect" class="form-select">
                            <option value="EGP">EGP (جنيه)</option>
                            <option value="USD">USD (دولار)</option>
                            <option value="EUR">EUR (يورو)</option>
                        </select>
                    </div>

                    <div class="col-md-12 mt-3">
                        <label class="form-label small text-white-50">إرفاق صورة التحويل (سكرين شوت / إيصال)</label>
                        <input type="file" name="transferImage" class="form-control" accept="image/*">
                    </div>

                    <div class="col-12 mt-4">
                        <button type="submit" class="btn btn-info w-100 py-2 fw-bold shadow-sm text-dark">
                            <i class="fas fa-check-double me-1"></i> تأكيد وإيداع في الحساب
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="glass-card shadow-lg border-0 overflow-hidden">
            <div class="p-3 bg-white bg-opacity-10 d-flex justify-content-between align-items-center">
                <span class="fw-bold"><i class="fas fa-list-ul me-2"></i> سجل التحويلات الواردة</span>
                <span class="badge rounded-pill bg-info text-dark">إجمالي العمليات: <%= transfers.length %></span>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0 text-center">
                    <thead>
                        <tr>
                            <th class="py-3">التاريخ</th>
                            <th>الوصل</th>
                            <th>البيان</th>
                            <th>الشاسيه</th>
                            <th>الحساب</th>
                            <th>القيمة</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (transfers.length===0) { %>
                            <tr>
                                <td colspan="6" class="py-5 text-white-50 fs-5">لا توجد سجلات بنكية حالياً.</td>
                            </tr>
                            <% } else { %>
                                <% [...transfers].reverse().forEach(t=> { %>
                                    <tr>
                                        <td class="small text-white-50">
                                            <%= t.date || '---' %>
                                        </td>
                                        <td>
                                            <% if (t.image) { %>
                                                <a href="<%= t.image %>" target="_blank">
                                                    <img src="<%= t.image %>" class="img-preview" alt="وصل">
                                                </a>
                                                <% } else { %>
                                                    <i class="fas fa-file-invoice text-white-50"></i>
                                                    <% } %>
                                        </td>
                                        <td class="text-start">
                                            <div class="fw-bold">
                                                <%= t.note %>
                                            </div>
                                            <div class="small text-info-custom">Ref: <%= t.refNumber %>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge-bank font-monospace">
                                                <i class="fas fa-car me-1"></i>
                                                <%= t.chassis %>
                                            </span>
                                        </td>
                                        <td>
                                            <div class="fw-bold">
                                                <%= t.bankName %>
                                            </div>
                                        </td>
                                        <td class="fw-bold text-success-custom">
                                            <%= parseFloat(t.amount).toLocaleString() %>
                                                <small>
                                                    <%= t.currency || 'EGP' %>
                                                </small>
                                        </td>
                                    </tr>
                                    <% }) %>
                                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="modal fade" id="accountsModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0"
                style="background: rgba(10, 25, 47, 0.95); backdrop-filter: blur(20px); border: 1px solid rgba(52, 152, 219, 0.2) !important;">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-info"><i class="fas fa-university me-2"></i> حسابات شركة الكابتن
                        المعتمدة</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 text-end">
                    <div class="row g-3">

                        <div class="col-md-6">
                            <div class="glass-card p-3 account-selection-card"
                                onclick="selectAccount('بنك مصر - ج.م', 'EGP', 'بنك مصر (1562)')">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h6 class="text-white mb-1">بنك مصر (بالجنيه)</h6>
                                        <small class="text-white-50 d-block">A/C: 5630001000001562</small>
                                    </div>
                                    <span class="badge bg-success">EGP</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="glass-card p-3 account-selection-card"
                                onclick="selectAccount('بنك مصر - USD', 'USD', 'بنك مصر دولاري (2147)')">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h6 class="text-white mb-1">بنك مصر (دولاري)</h6>
                                        <small class="text-white-50 d-block">A/C: 1590120000002147</small>
                                    </div>
                                    <span class="badge bg-primary">USD</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="glass-card p-3 account-selection-card"
                                onclick="selectAccount('بنك القاهرة - ج.م', 'EGP', 'بنك القاهرة (5424)')">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h6 class="text-white mb-1">بنك القاهرة (بالجنيه)</h6>
                                        <small class="text-white-50 d-block">A/C: 01905010255424</small>
                                    </div>
                                    <span class="badge bg-success">EGP</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="glass-card p-3 account-selection-card"
                                onclick="selectAccount('بنك القاهرة - USD', 'USD', 'بنك القاهرة دولاري (3577)')">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h6 class="text-white mb-1">بنك القاهرة (دولاري)</h6>
                                        <small class="text-white-50 d-block">A/C: 01906010093577</small>
                                    </div>
                                    <span class="badge bg-primary">USD</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="glass-card p-3 account-selection-card"
                                onclick="selectAccount('انستا باي - InstaPay', 'EGP', 'InstaPay (وليد رمضان)')">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h6 class="text-white mb-1">InstaPay (انستا باي)</h6>
                                        <small class="text-white-50 d-block">ID: 01033377747</small>
                                    </div>
                                    <span class="badge bg-info text-dark">EGP</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="glass-card p-3 account-selection-card"
                                onclick="selectAccount('Sparkasse - EUR', 'EUR', 'Sparkasse (أحمد فتوح)')">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h6 class="text-white mb-1">Sparkasse (باليورو)</h6>
                                        <small class="text-white-50 d-block">A/C: 102009384</small>
                                    </div>
                                    <span class="badge bg-warning text-dark">EUR</span>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
                <div class="col-md-2" id="rateInputContainer" style="display: none;">
                    <label class="form-label small text-warning">سعر الصرف (اليوم)</label>
                    <input type="text" id="exchangeRateDisplay" class="form-control bg-dark text-warning border-warning"
                        readonly>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // الطريقة دي بتمنع الـ Error في المحرر وبتضمن إن الكود يشتغل صح
        const liveRates = {
            USD: parseFloat('<%= rates.USD %>') || 0,
            EUR: parseFloat('<%= rates.EUR %>') || 0
        };

        // باقي الكود زي ما هو بالظبط...
        function selectAccount(displayLabel, currency, hiddenValue) {
            document.getElementById('selectedAccountDisplay').value = displayLabel;
            document.getElementById('targetAccountValue').value = hiddenValue;
            document.getElementById('currencySelect').value = currency;

            // تحديث الحسبة فوراً
            calculateEquivalent();

            const modalElement = document.getElementById('accountsModal');
            const modal = bootstrap.Modal.getInstance(modalElement);
            modal.hide();
        }

        function calculateEquivalent() {
            const amount = parseFloat(document.getElementById('amountInput').value) || 0;
            const currency = document.getElementById('currencySelect').value;
            const convArea = document.getElementById('conversionArea');
            const resultSpan = document.getElementById('egpResult');

            if (amount > 0 && currency !== 'EGP') {
                convArea.style.display = 'block';
                const rate = (currency === 'USD') ? liveRates.USD : liveRates.EUR;
                const total = amount * rate;
                resultSpan.innerText = total.toLocaleString('ar-EG', { maximumFractionDigits: 2 });
            } else {
                convArea.style.display = 'none';
            }
        }

        // ربط الأحداث للحساب التلقائي
        document.getElementById('amountInput').addEventListener('input', calculateEquivalent);
        document.getElementById('currencySelect').addEventListener('change', calculateEquivalent);
    </script>
    <%- include('partials/signature') %>

</body>

</html>