<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>أرشيف السيارات المباعة | السلسلة العالمية</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background: linear-gradient(rgba(15, 32, 39, 0.9), rgba(32, 58, 67, 0.9)),
                url('https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?q=80&w=2083&auto=format&fit=crop');
            background-size: cover;
            background-attachment: fixed;
            color: #fff;
            font-family: 'Segoe UI', sans-serif;
            min-height: 100vh;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
        }

        .table {
            color: #fff !important;
            border-color: rgba(255, 255, 255, 0.1);
        }

        .status-sold {
            background: rgba(46, 204, 113, 0.2);
            color: #2ecc71;
            border: 1px solid #2ecc71;
            padding: 4px 12px;
            border-radius: 8px;
            font-size: 0.85rem;
            font-weight: bold;
        }

        .car-title {
            color: #00d2ff;
            font-weight: bold;
            font-size: 1.1rem;
            display: block;
            margin-bottom: 5px;
        }

        .finance-info div {
            font-size: 0.85rem;
            margin-bottom: 2px;
        }

        .btn-back {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #fff;
            transition: 0.3s;
        }

        .btn-back:hover {
            background: #fff;
            color: #000;
        }
    </style>
</head>

<body>
    <div class="d-flex align-items-center gap-3 no-print">
        <span class="text-light">
            مرحباً، <strong class="text-info">
                <%= user.name %>
            </strong>
            <span class="badge bg-secondary ms-1">
                <%= user.role==='admin' ? 'مدير' : 'موظف' %>
            </span>
        </span>
        <a href="/logout" class="btn btn-sm btn-outline-danger">
            <i class="fas fa-sign-out-alt"></i> خروج
        </a>
    </div>
    <div class="container mt-4 pb-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="text-danger fw-bold"><i class="fas fa-history me-2"></i> أرشيف السيارات المباعة</h2>
                <p class="text-white-50 small">السجل التاريخي للسيارات التي خرجت من الجرد</p>
            </div>
            <a href="/cars" class="btn btn-back rounded-pill px-4">
                <i class="fas fa-arrow-right me-1"></i> العودة للجرد المتاح
            </a>
        </div>

        <div class="glass-card shadow-lg overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle text-center mb-0">
                    <thead class="bg-danger bg-opacity-25 border-bottom border-danger">
                        <tr>
                            <th class="py-3 text-start ps-4">السيارة والموقف المالي</th>
                            <th>رقم الشاسيه</th>
                            <th>سعر البيع النهائي</th>
                            <th>الحالة</th>
                            <th>ملاحظات التسليم</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (typeof cars==='undefined' || cars.length===0) { %>
                            <tr>
                                <td colspan="5" class="py-5 text-white-50 fs-5">
                                    <i class="fas fa-folder-open d-block mb-2 fa-2x"></i>
                                    لا توجد سيارات مباعة في هذا الأرشيف بعد.
                                </td>
                            </tr>
                            <% } else { %>
                                <% cars.reverse().forEach(car=> { %>
                                    <tr>
                                        <td class="text-start ps-4">
                                            <span class="car-title">
                                                <%= car.brand %>
                                                    <%= car.model %> (<%= car.year %>)
                                            </span>
                                            <div class="finance-info">
                                                <div class="text-white-50">الإجمالي: <%= (car.price ||
                                                        0).toLocaleString() %> ج.م</div>
                                                <div class="text-success">المدفوع: <%= (car.paid || 0).toLocaleString()
                                                        %> ج.م</div>
                                                <% if (car.remaining> 0) { %>
                                                    <div class="text-warning">المتبقي: <%= (car.remaining ||
                                                            0).toLocaleString() %> ج.م</div>
                                                    <% } else { %>
                                                        <div class="text-info font-monospace small">خالص الثمن <i
                                                                class="fas fa-check-circle"></i></div>
                                                        <% } %>
                                            </div>
                                        </td>

                                        <td>
                                            <span class="badge bg-light text-dark font-monospace"
                                                style="letter-spacing: 1px;">
                                                <%= car.chassis %>
                                            </span>
                                        </td>

                                        <td class="fw-bold text-success fs-5">
                                            <%= (car.price || 0).toLocaleString() %> <small>ج.م</small>
                                        </td>

                                        <td>
                                            <span class="status-sold">
                                                <i class="fas fa-handshake me-1"></i> تم البيع
                                            </span>
                                        </td>

                                        <td class="text-white-50 small">
                                            <div>
                                                <%= car.deliveryDate || car.date || 'تاريخ غير مسجل' %>
                                            </div>
                                            <div style="font-size: 0.7rem;">تم الأرشفة تلقائياً</div>
                                        </td>
                                    </tr>
                                    <% }) %>
                                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <%- include('partials/signature') %>

</body>

</html>