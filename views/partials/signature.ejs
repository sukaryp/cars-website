<div class="programmer-signature">
    <div class="d-flex align-items-center gap-2">
        <div class="pulse-dot"></div>
        <span>Developed by <strong class="engineer-name">ENG.Belal Hesham</strong></span>
        <span class="version-tag">v2.0.33</span>
    </div>
</div>

<style>
    .programmer-signature {
        position: fixed;
        bottom: 15px;
        left: 20px; /* أو right حسب ذوقك */
        background: rgba(0, 242, 255, 0.05);
        backdrop-filter: blur(5px);
        padding: 5px 15px;
        border-radius: 50px;
        border: 1px solid rgba(0, 242, 255, 0.2);
        font-family: 'Courier New', Courier, monospace;
        font-size: 11px;
        color: rgba(255, 255, 255, 0.6);
        z-index: 9999;
        letter-spacing: 1px;
        transition: 0.3s;
        cursor: default;
    }

    .programmer-signature:hover {
        background: rgba(0, 242, 255, 0.15);
        color: #00f2ff;
        border-color: #00f2ff;
        transform: translateY(-3px);
        box-shadow: 0 0 15px rgba(0, 242, 255, 0.3);
    }

    .engineer-name {
        color: #00f2ff;
        text-shadow: 0 0 5px rgba(0, 242, 255, 0.5);
    }

    .pulse-dot {
        width: 6px;
        height: 6px;
        background-color: #00f2ff;
        border-radius: 50%;
        box-shadow: 0 0 10px #00f2ff;
        animation: pulse-signature 2s infinite;
    }

    .version-tag {
        background: rgba(255, 255, 255, 0.1);
        padding: 1px 6px;
        border-radius: 4px;
        margin-right: 5px;
        font-size: 9px;
    }

    @keyframes pulse-signature {
        0% { transform: scale(0.95); opacity: 0.7; }
        50% { transform: scale(1.2); opacity: 1; }
        100% { transform: scale(0.95); opacity: 0.7; }
    }

    /* تختفي عند الطباعة */
    @media print {
        .programmer-signature { display: none; }
    }
</style>