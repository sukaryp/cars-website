<div class="modal fade" id="addUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-info text-white" style="border-radius: 20px; border: 1px solid #00f2ff !important;">
            <div class="modal-header border-0">
                <h5 class="modal-title text-info"><i class="fas fa-user-plus me-2"></i>إضافة موظف جديد</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/admin/add-user" method="POST">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="small text-info">الاسم بالكامل</label>
                        <input type="text" name="name" class="form-control bg-transparent text-white border-secondary" required>
                    </div>
                    <div class="mb-3">
                        <label class="small text-info">اسم المستخدم</label>
                        <input type="text" name="username" class="form-control bg-transparent text-white border-secondary" required>
                    </div>
                    <div class="mb-3">
                        <label class="small text-info">كلمة السر</label>
                        <input type="password" name="password" class="form-control bg-transparent text-white border-secondary" required>
                    </div>
                    <div class="mb-3">
                        <label class="small text-info">الصلاحية</label>
                        <select name="role" class="form-select bg-dark text-white border-secondary">
                            <option value="employee">محاسب (Officer)</option>
                            <option value="admin">مدير (Commander)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="submit" class="btn btn-info w-100 rounded-pill shadow-sm">تفعيل الحساب</button>
                </div>
            </form>
        </div>
    </div>
</div>