<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <title>حركة العهدة والمصاريف</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background: linear-gradient(rgba(11, 11, 26, 0.7), rgba(11, 11, 26, 0.85)),
                url('https://images.unsplash.com/photo-1590283603385-17ffb3a7f29f?q=80&w=2070&auto=format&fit=crop');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            color: #fdfdfd;
            font-family: 'Segoe UI', sans-serif;
            min-height: 100vh;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.07);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        }

        .form-control,
        .form-select {
            background: rgba(255, 255, 255, 0.9) !important;
            color: #000 !important;
            border: 1px solid #0dcaf0;
            font-weight: 600;
        }

        .table {
            color: #fff !important;
            border-color: rgba(255, 255, 255, 0.1);
        }

        .table thead {
            background: rgba(13, 202, 240, 0.2);
            color: #0dcaf0;
        }

        .table tbody tr {
            background: rgba(0, 0, 0, 0.2);
            transition: 0.3s;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .table tbody tr:hover {
            background: rgba(255, 255, 255, 0.05);
        }

        .text-info-custom {
            color: #0dcaf0 !important;
            text-shadow: 1px 1px 2px #000;
        }

        .text-success-custom {
            color: #2ecc71 !important;
            text-shadow: 1px 1px 2px #000;
        }

        .text-danger-custom {
            color: #e74c3c !important;
            text-shadow: 1px 1px 2px #000;
        }

        .balance-box {
            padding: 10px 15px;
            border-radius: 12px;
            text-align: center;
            min-width: 120px;
        }

        .btn-info-custom {
            background: #0dcaf0;
            color: #000;
            font-weight: bold;
            border-radius: 10px;
            transition: 0.3s;
        }

        .btn-info-custom:hover {
            background: #00b4d8;
            transform: translateY(-2px);
        }

        .badge-category {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 4px 10px;
            border-radius: 8px;
            color: #ffc107;
            font-size: 0.85rem;
        }
    </style>
</head>

<body>
    <div class="container-fluid py-2 no-print" style="background: rgba(0,0,0,0.3);">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <span class="text-light">
                    مرحباً، <strong class="text-info"><%= user.name %></strong>
                    <span class="badge bg-secondary ms-1"><%= user.role==='admin' ? 'مدير' : 'موظف' %></span>
                </span>
                <a href="/logout" class="btn btn-sm btn-outline-danger">
                    <i class="fas fa-sign-out-alt"></i> خروج
                </a>
            </div>
            <a href="/" class="btn btn-sm btn-outline-light rounded-pill px-3">الرئيسية</a>
        </div>
    </div>

    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="text-info-custom mb-0"><i class="fas fa-wallet me-2"></i> حركة العهدة والمصاريف</h2>
                <small class="text-white-50">إدارة التدفقات المالية للشركة</small>
            </div>

            <div class="d-flex gap-2">
                <div class="balance-box bg-dark border border-primary shadow-sm">
                    <small class="d-block text-white-50 small">رصيد (EGP)</small>
                    <span class="fw-bold text-info"><%= balEGP.toLocaleString() %></span>
                </div>
                <div class="balance-box bg-dark border border-success shadow-sm">
                    <small class="d-block text-white-50 small">رصيد (USD)</small>
                    <span class="fw-bold text-success"><%= balUSD.toLocaleString() %></span>
                </div>
                <div class="balance-box bg-dark border border-warning shadow-sm">
                    <small class="d-block text-white-50 small">رصيد (EUR)</small>
                    <span class="fw-bold text-warning"><%= balEUR.toLocaleString() %></span>
                </div>
            </div>
        </div>

        <div class="glass-card p-4 mb-4">
            <h5 class="mb-3 text-info-custom small fw-bold"><i class="fas fa-plus-circle me-2"></i> تسجيل حركة جديدة</h5>
            <form action="/add-expense" method="POST" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label text-white-50 small">البيان (صيانة/عهدة/إلخ)</label>
                    <input type="text" name="reason" class="form-control" placeholder="مثلاً: عهدة من المدير" required>
                </div>
                <div class="col-md-2">
                    <label class="form-label text-white-50 small">نوع الحركة</label>
                    <select name="type" class="form-select">
                        <option value="in">إيراد / عهدة (+)</option>
                        <option value="out">مصروف / صيانة (-)</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label text-white-50 small">الفئة</label>
                    <select name="category" class="form-select">
                        <option value="صيانة">صيانة سيارات</option>
                        <option value="مرتبات">مرتبات</option>
                        <option value="بوفيه">بوفية</option>
                        <option value="منظفات">منظفات</option>
                        <option value="كهرباء">كهرباء</option>
                        <option value="نت_وارضي">نت أرضي</option>
                        <option value="كروت_شحن">كروت شحن</option>
                        <option value="ادارة">إدارة</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label text-white-50 small">العملة</label>
                    <select name="currency" class="form-select">
                        <option value="EGP">جنيه (EGP)</option>
                        <option value="USD">دولار (USD)</option>
                        <option value="EUR">يورو (EUR)</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label text-white-50 small">المبلغ</label>
                    <input type="number" name="amount" class="form-control" placeholder="0.00" step="0.01" required>
                </div>
                <div class="col-md-1 d-flex align-items-end">
                    <button type="submit" class="btn btn-info-custom w-100 py-2"><i class="fas fa-save"></i></button>
                </div>
            </form>
        </div>

        <div class="glass-card p-0 shadow overflow-hidden">
            <div class="p-3 border-bottom border-secondary d-flex justify-content-between align-items-center" style="background: rgba(255,255,255,0.03)">
                <h6 class="mb-0 text-info-custom small fw-bold"><i class="fas fa-history me-2"></i> سجل العمليات الأخيرة</h6>
                <span class="badge bg-dark">مُحدث لحظياً</span>
            </div>
            <div class="table-responsive">
                <table class="table align-middle text-center mb-0">
                    <thead>
                        <tr>
                            <th>التاريخ</th>
                            <th>البيان</th>
                            <th>الفئة</th>
                            <th>المبلغ</th>
                            <th>العملة</th>
                            <th>النوع</th>
                            <th>بواسطة</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (expenses.length===0) { %>
                            <tr>
                                <td colspan="7" class="py-4 text-white-50">لا توجد عمليات مسجلة</td>
                            </tr>
                        <% } %>
                        <% expenses.reverse().forEach(item => { %>
                            <tr>
                                <td class="small"><%= item.date %></td>
                                <td class="fw-bold"><%= item.reason %></td>
                                <td><span class="badge-category"><%= item.category %></span></td>
                                <td class="<%= item.type==='in' ? 'text-success-custom' : 'text-danger-custom' %> fw-bold fs-5">
                                    <%= item.amount.toLocaleString() %>
                                </td>
                                <td><span class="badge bg-light text-dark small"><%= item.currency || 'EGP' %></span></td>
                                <td>
                                    <% if(item.type==='in' ) { %>
                                        <i class="fas fa-arrow-down text-success"></i> <small>دخول</small>
                                    <% } else { %>
                                        <i class="fas fa-arrow-up text-danger"></i> <small>خروج</small>
                                    <% } %>
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark">
                                        <i class="fas fa-user me-1"></i>
                                        <%= item.createdBy || 'المدير' %>
                                    </span>
                                    <br>
                                    <small class="text-white-50" style="font-size: 0.7rem;">
                                        <%= item.createdAt || '' %>
                                    </small>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <%- include('partials/signature') %>

</body>

</html>