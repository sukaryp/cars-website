<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <title>فواتير الاستلام الفوري (كاش)</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background: linear-gradient(rgba(20, 30, 48, 0.9), rgba(36, 59, 85, 0.9)),
                url('https://images.unsplash.com/photo-1580519542036-c47de6196ba5?q=80&w=2071&auto=format&fit=crop');
            background-size: cover;
            background-attachment: fixed;
            color: #ffffff;
            font-family: 'Segoe UI', sans-serif;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
        }

        .form-control,
        .form-select {
            background: #fff !important;
            color: #000 !important;
            font-weight: 600;
        }

        .table {
            color: #fdfdfd !important;
        }

        .text-gold {
            color: #ffd700 !important;
        }
    </style>
</head>

<body>
    <div class="d-flex align-items-center gap-3 no-print">
        <span class="text-light">
            مرحباً، <strong class="text-info">
                <%= user.name %>
            </strong>
            <span class="badge bg-secondary ms-1">
                <%= user.role==='admin' ? 'مدير' : 'موظف' %>
            </span>
        </span>
        <a href="/logout" class="btn btn-sm btn-outline-danger">
            <i class="fas fa-sign-out-alt"></i> خروج
        </a>
    </div>
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="text-gold fw-bold"><i class="fas fa-money-bill-wave me-2"></i> فواتير الكاش (استلام فوري)</h2>
            <a href="/" class="btn btn-outline-light rounded-pill">الرئيسية</a>
        </div>

        <div class="glass-card p-4 mb-4">
            <form action="/add-cash-payment" method="POST" class="row g-3">
                <div class="col-md-3">
                    <label class="small mb-1">اسم العميل</label>
                    <input type="text" name="customerName" class="form-control" placeholder="اكتب اسم العميل" required>
                </div>
                <div class="col-md-3">
                    <label class="small mb-1">السيارة (الشاسيه)</label>
                    <select name="chassis" class="form-select" required>
                        <option value="" disabled selected>اختر السيارة...</option>
                        <% cars.forEach(car=> { %>
                            <option value="<%= car.chassis %>">
                                <%= car.brand %> - <%= car.chassis %>
                            </option>
                            <% }) %>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="small mb-1">العملة</label>
                    <select name="currency" id="currencySelect" class="form-select">
                        <option value="EGP">جنيه (EGP)</option>
                        <option value="USD">دولار (USD)</option>
                        <option value="EUR">يورو (EUR)</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="small mb-1">المبلغ</label>
                    <input type="number" name="amount" class="form-control" step="0.01" required>
                </div>
                <div class="col-md-2" id="rateBox" style="display: none;">
                    <label class="small mb-1 text-gold">سعر الصرف (للجنية)</label>
                    <input type="number" name="rate" class="form-control" value="1" step="0.01">
                </div>
                <div class="col-md-12 d-flex align-items-end justify-content-end mt-3">
                    <button type="submit" class="btn btn-warning px-5 fw-bold shadow-sm">إصدار فاتورة قبض</button>
                </div>
            </form>
        </div>

        <div class="glass-card overflow-hidden">
            <table class="table table-hover align-middle text-center mb-0">
                <thead class="bg-warning text-dark">
                    <tr>
                        <th>التاريخ</th>
                        <th>العميل</th>
                        <th>المبلغ المدفوع</th>
                        <th>سعر الصرف</th>
                        <th>القيمة بالمصري</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (payments && payments.length> 0) { %>
                        <% payments.reverse().forEach(p=> {
                            // 1. معالجة البيانات بأمان قبل العرض
                            let reasonStr = p.reason || '';
                            let customer = 'عميل كاش';
                            let chassis = '';

                            if (reasonStr.includes(':')) {
                            let parts = reasonStr.split(':');
                            customer = parts[1] ? parts[1].split('(')[0].split('-')[0].trim() : 'عميل كاش';
                            } else {
                            customer = reasonStr || 'عميل كاش';
                            }

                            if (reasonStr.includes('-')) {
                            chassis = reasonStr.split('-')[1].trim();
                            }

                            let amt = parseFloat(p.amount) || 0;
                            let rt = parseFloat(p.rate) || (p.currency !== 'EGP' ? 50 : 1);
                            let totalEGP = amt * rt;
                            %>
                            <tr>
                                <td>
                                    <%= p.date %>
                                </td>
                                <td>
                                    <div class="fw-bold">
                                        <%= customer %>
                                    </div>
                                    <% if (chassis) { %>
                                        <small class="text-white-50" style="font-size: 0.7rem;">
                                            <%= chassis %>
                                        </small>
                                        <% } %>
                                </td>
                                <td class="fw-bold text-gold">
                                    <%= amt.toLocaleString() %>
                                        <span class="badge bg-light text-dark small">
                                            <%= p.currency || 'EGP' %>
                                        </span>
                                </td>
                                <td class="fw-bold text-gold">
                                    <% if (p.currency && p.currency !=='EGP' ) { %>
                                        1 <%= p.currency %> = <%= rt %> ج.م
                                                <% } else { %>
                                                    -
                                                    <% } %>
                                </td>
                                <td class="fw-bold text-info">
                                    <%= totalEGP.toLocaleString() %> ج.م
                                </td>
                            </tr>
                            <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5" class="py-4 text-white-50">لا توجد مبيعات مسجلة</td>
                                    </tr>
                                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <script>
        const currencySelect = document.getElementById('currencySelect');
        const rateBox = document.getElementById('rateBox');
        const rateInput = rateBox.querySelector('input');

        currencySelect.addEventListener('change', function () {
            if (this.value !== 'EGP') {
                rateBox.style.display = 'block';
                rateInput.required = true;
                // لو دولار حط 50 ولو يورو حط 55 كبداية وانت غيرهم براحتك
                if (this.value === 'USD' && (rateInput.value == '1' || !rateInput.value)) rateInput.value = '50';
                if (this.value === 'EUR' && (rateInput.value == '1' || !rateInput.value)) rateInput.value = '55';
            } else {
                rateBox.style.display = 'none';
                rateInput.required = false;
                rateInput.value = '1';
            }
        });
    </script>
    <%- include('partials/signature') %>

</body>

</html>