<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <title>إدارة الموظفين والمرتبات</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        body {
            background: linear-gradient(rgba(11, 11, 26, 0.85), rgba(11, 11, 26, 0.85)),
                url('https://images.unsplash.com/photo-1497366216548-37526070297c?q=80&w=2070&auto=format&fit=crop');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            color: #fdfdfd;
            font-family: 'Segoe UI', sans-serif;
            min-height: 100vh;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.07);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        }

        .form-control,
        .form-select {
            background: rgba(255, 255, 255, 0.9) !important;
            color: #000 !important;
            border: 1px solid #0dcaf0;
            font-weight: 500;
        }

        .table {
            color: #fff !important;
        }

        .table thead {
            background: rgba(13, 202, 240, 0.2);
            color: #0dcaf0;
        }

        .text-info-custom {
            color: #0dcaf0 !important;
        }

        .text-warning-custom {
            color: #ffc107 !important;
        }

        .text-danger-custom {
            color: #ff4d4d !important;
        }

        .btn-info-custom {
            background: #0dcaf0;
            color: #000;
            font-weight: bold;
            border-radius: 10px;
        }

        .salary-badge {
            background: rgba(13, 202, 240, 0.1);
            border: 1px solid rgba(13, 202, 240, 0.3);
            padding: 5px 10px;
            border-radius: 8px;
        }
    </style>
</head>

<body>
    <div class="d-flex align-items-center gap-3 no-print">
        <span class="text-light">
            مرحباً، <strong class="text-info">
                <%= user.name %>
            </strong>
            <span class="badge bg-secondary ms-1">
                <%= user.role==='admin' ? 'مدير' : 'موظف' %>
            </span>
        </span>
        <a href="/logout" class="btn btn-sm btn-outline-danger">
            <i class="fas fa-sign-out-alt"></i> خروج
        </a>
    </div>
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="text-info-custom"><i class="fas fa-users-cog me-2"></i> إدارة الموظفين</h2>
            <div class="d-flex gap-2">
                <a href="/" class="btn btn-outline-light rounded-pill">الرئيسية</a>
            </div>
        </div>

        <div class="glass-card p-4 mb-5">
            <h5 class="mb-3 text-info-custom small"><i class="fas fa-user-plus me-1"></i> إضافة موظف جديد</h5>
            <form action="/add-employee" method="POST" class="row g-3">
                <div class="col-md-4">
                    <input type="text" name="name" class="form-control" placeholder="اسم الموظف" required>
                </div>
                <div class="col-md-3">
                    <input type="text" name="position" class="form-control" placeholder="الوظيفة">
                </div>
                <div class="col-md-3">
                    <input type="number" name="salary" class="form-control" placeholder="الراتب الأساسي" required>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-info-custom w-100 shadow-sm">إضافة</button>
                </div>
            </form>
        </div>

        <div class="glass-card p-3 shadow">
            <div class="table-responsive">
                <table class="table align-middle text-center">
                    <thead>
                        <tr>
                            <th>الموظف</th>
                            <th>الراتب الأساسي</th>
                            <th>منصرف (سلف)</th>
                            <th>خصومات</th>
                            <th class="text-info-custom">صافي المتبقي</th>
                            <th style="min-width: 350px;">إجراءات سريعة</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% employees.forEach(emp=> { %>
                            <tr>
                                <td class="text-end ps-4">
                                    <div class="fw-bold text-black fs-5">
                                        <%= emp.name %>
                                    </div>
                                    <div class="text-info small">
                                        <%= emp.position %>
                                    </div>
                                </td>
                                <td><span class="salary-badge text-info fw-bold">
                                        <%= emp.salary.toLocaleString() %> ج.م
                                    </span></td>
                                <td class="text-danger-custom fw-bold fs-5">
                                    <%= (emp.totalPaid || 0).toLocaleString() %> ج.م
                                </td>
                                <td class="text-warning-custom fw-bold">
                                    <%= (emp.totalDeductions || 0).toLocaleString() %> ج.م
                                </td>
                                <td>
                                    <div class="p-2 bg-info text-dark rounded-pill fw-bolder">
                                        <%= (emp.netSalary || 0).toLocaleString() %> ج.م
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex flex-column gap-2">
                                        <form action="/add-employee-transaction" method="POST" class="d-flex gap-1">
                                            <input type="hidden" name="empName" value="<%= emp.name %>">
                                            <input type="hidden" name="type" value="خصم">
                                            <input type="number" name="amount"
                                                class="form-control form-control-sm border-warning fw-bold"
                                                placeholder="مبلغ الخصم" required>
                                            <button type="submit"
                                                class="btn btn-warning btn-sm fw-bold w-25">خصم</button>
                                        </form>
                                        <form action="/add-employee-transaction" method="POST" class="d-flex gap-1">
                                            <input type="hidden" name="empName" value="<%= emp.name %>">
                                            <input type="number" name="amount"
                                                class="form-control form-control-sm border-primary fw-bold"
                                                placeholder="مبلغ الصرف" required>
                                            <select name="type" class="form-select form-select-sm fw-bold"
                                                style="width: auto;">
                                                <option value="سلفة">سلفة</option>
                                                <option value="مرتب">مرتب</option>
                                            </select>
                                            <button type="submit"
                                                class="btn btn-primary btn-sm fw-bold w-25">صرف</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <%- include('partials/signature') %>

</body>

</html>