<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <title>رادار الشحنات والاستيراد</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        body {
            background: linear-gradient(rgba(11, 11, 26, 0.8), rgba(11, 11, 26, 0.8)),
                url('https://images.unsplash.com/photo-1494412519320-aa613dfb7738?q=80&w=2000&auto=format&fit=crop');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            color: #e0e0e0;
            font-family: 'Segoe UI', sans-serif;
            min-height: 100vh;
        }

        .glass-header {
            background: rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(15px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .import-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(12px);
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.4s ease;
        }

        .import-card:hover {
            transform: translateY(-10px);
            border-color: #0dcaf0;
        }

        .status-timeline {
            display: flex;
            justify-content: space-between;
            margin: 30px 0;
            position: relative;
        }

        .status-timeline::before {
            content: "";
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            height: 2px;
            background: rgba(255, 255, 255, 0.1);
            z-index: 1;
        }

        .step {
            z-index: 2;
            background: #101028;
            padding: 5px 15px;
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            font-size: 0.75rem;
            color: #aaa;
        }

        .step.active {
            border-color: #0dcaf0;
            color: #fff;
            background: #0dcaf033;
            box-shadow: 0 0 15px #0dcaf066;
        }

        .countdown-box {
            background: linear-gradient(135deg, rgba(188, 19, 254, 0.2), rgba(13, 202, 240, 0.2));
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            padding: 12px;
            text-align: center;
            min-width: 140px;
        }

        .finance-badge {
            background: rgba(0, 0, 0, 0.3);
            border-radius: 12px;
            padding: 15px;
            border-right: 4px solid #bc13fe;
        }

        .search-box {
            background: rgba(255, 255, 255, 0.05) !important;
            color: white !important;
            border-radius: 15px !important;
        }

        .text-purple-neon {
            color: #bc13fe;
            font-weight: bold;
        }
    </style>
</head>

<body>
    <div class="d-flex align-items-center gap-3 no-print">
        <span class="text-light">
            مرحباً، <strong class="text-info">
                <%= user.name %>
            </strong>
            <span class="badge bg-secondary ms-1">
                <%= user.role==='admin' ? 'مدير' : 'موظف' %>
            </span>
        </span>
        <a href="/logout" class="btn btn-sm btn-outline-danger">
            <i class="fas fa-sign-out-alt"></i> خروج
        </a>
    </div>
    <div class="glass-header py-3 mb-5 sticky-top">
        <div class="container d-flex justify-content-between align-items-center">
            <h3 class="m-0 text-info"><i class="fas fa-radar me-2"></i> رادار الاستيراد</h3>
            <div class="d-flex gap-3 w-50">
                <input type="text" id="searchInput" class="form-control search-box"
                    placeholder="ابحث عن سيارة، عميل، أو سيلز...">
            </div>
            <div>
                <a href="/archive" class="btn btn-outline-success rounded-pill btn-sm me-2">الأرشيف</a>
                <a href="/" class="btn btn-outline-light rounded-pill btn-sm">الرئيسية</a>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="row" id="importContainer">
            <% imports.reverse().forEach(item=> { %>
                <div class="col-lg-6 mb-4 import-item">
                    <div class="import-card p-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h4 class="fw-bold mb-0 text-white">
                                    <%= item.name %>
                                </h4>
                                <span class="small text-purple-neon">مسؤول المبيعات: <%= item.salesName || 'إدارة' %>
                                        </span>
                            </div>
                            <div class="countdown-box">
                                <div class="small mb-1">متوقع وصولها خلال</div>
                                <div class="timer fw-bold text-info" data-arrival="<%= item.expectedArrival %>">
                                    جاري الحساب...
                                </div>
                            </div>
                        </div>

                        <div class="status-timeline">
                            <div class="step <%= item.status === 'تجهيز' ? 'active' : '' %>">تجهيز</div>
                            <div class="step <%= item.status === 'شحن بحري' ? 'active' : '' %>">شحن</div>
                            <div class="step <%= item.status === 'جمارك' ? 'active' : '' %>">جمارك</div>
                            <div class="step <%= item.status === 'وصلت' ? 'active' : '' %>">وصلت</div>
                        </div>

                        <div class="row mt-4">
                            <div class="col-6">
                                <div class="finance-badge">
                                    <div class="small text-white-50">اسم العميل</div>
                                    <div class="fw-bold text-truncate">
                                        <%= item.customerName %>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="finance-badge border-start border-danger">
                                    <div class="small text-white-50">المتبقي التحصيلي</div>
                                    <div class="fw-bold text-danger">
                                        <%= ((item.totalPrice || 0) - (item.paidSoFar || 0)).toLocaleString() %> ج.م
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button onclick="updateStatus('<%= item.id %>')"
                                class="btn btn-sm btn-outline-info flex-grow-1 rounded-pill">تحديث الحالة</button>
                            <button onclick="addPayment('<%= item.id %>')"
                                class="btn btn-sm btn-info flex-grow-1 rounded-pill text-dark">تحصيل مبلغ</button>
                            <button onclick="completeDelivery('<%= item.id %>')"
                                class="btn btn-sm btn-success flex-grow-1 rounded-pill">إتمام التسليم</button>
                        </div>
                    </div>
                </div>
                <% }) %>
        </div>
    </div>

    <script>
        // 1. نظام البحث
        document.getElementById('searchInput').addEventListener('input', function (e) {
            const term = e.target.value.toLowerCase();
            document.querySelectorAll('.import-item').forEach(card => {
                card.style.display = card.innerText.toLowerCase().includes(term) ? 'block' : 'none';
            });
        });

        // 2. تحديث العداد (تم تعديله ليقرأ الشهور)
        function updateTimers() {
            document.querySelectorAll('.timer').forEach(timer => {
                const arrivalAttr = timer.getAttribute('data-arrival');
                if (!arrivalAttr || arrivalAttr === "undefined") {
                    timer.innerHTML = "غير محدد";
                    return;
                }

                const arrivalDate = new Date(arrivalAttr).getTime();
                const now = new Date().getTime();
                const diff = arrivalDate - now;

                if (diff <= 0) {
                    timer.innerHTML = "<span class='text-success'>وصلت</span>";
                    return;
                }

                // الحسبة بالشهور والأيام
                const months = Math.floor(diff / (1000 * 60 * 60 * 24 * 30.44));
                const days = Math.floor((diff % (1000 * 60 * 60 * 24 * 30.44)) / (1000 * 60 * 60 * 24));
                const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));

                let display = "";
                if (months > 0) display += months + " شهر و ";
                display += days + " يوم";

                timer.innerHTML = display + `<br><small style="font-size:0.7rem">${hours} ساعة متبقية</small>`;
            });
        }

        setInterval(updateTimers, 60000);
        updateTimers();

        // 3. وظائف التفاعل مع السيرفر
        function updateStatus(id) {
            const newStatus = prompt("الحالة الجديدة (تجهيز / شحن بحري / جمارك / وصلت):");
            if (newStatus) {
                fetch('/update-import-payment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ importId: id, status: newStatus, type: 'status_only' })
                }).then(() => location.reload());
            }
        }

        function addPayment(id) {
            const amount = prompt("أدخل المبلغ المحصل:");
            if (amount && !isNaN(amount)) {
                fetch('/update-import-payment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ importId: id, amount: parseFloat(amount), type: 'collection' })
                }).then(() => location.reload());
            }
        }

        function completeDelivery(id) {
            if (confirm('تأكيد إتمام التسليم والأرشفة؟')) {
                fetch('/complete-delivery', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ importId: id })
                }).then(res => res.json()).then(data => { if (data.success) location.reload(); });
            }
        }
    </script>
        <%- include('partials/signature') %>

</body>

</html>